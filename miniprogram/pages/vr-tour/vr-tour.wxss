.vr-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #1E1711;
  color: #2A1F14;
}

.vr-viewer {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #1E1711;
  isolation: isolate;
}

.vr-canvas {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100vh;
  display: block;
  background: #1E1711;
}

.vr-viewer::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80% 70% at 50% 48%, transparent 54%, rgba(20,14,10,0.22) 100%),
    repeating-linear-gradient(0deg, rgba(255,255,255,0.025) 0 1rpx, transparent 1rpx 5rpx);
}

.vr-loading,
.vr-empty {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(42,31,20,0.70);
  color: #E8D5B5;
  font-size: calc(24rpx * var(--fs-scale, 1));
  letter-spacing: 1rpx;
}

.vr-state-icon {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #E8D5B5;
  font-weight: 800;
}

.loading-ring {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(232,213,181,0.34);
  border-top-color: #E8D5B5;
  animation: vrSpin 0.86s linear infinite;
}

@keyframes vrSpin {
  to { transform: rotate(360deg); }
}

.scene-tabs {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  display: flex;
  padding: 22rpx 30rpx 48rpx;
  background: rgba(20,14,10,0.44);
  box-sizing: border-box;
}

.scene-tab {
  min-width: 0;
  flex: 1;
  height: 74rpx;
  border-radius: 12rpx;
  background: rgba(255,252,245,0.88);
  border: 2rpx solid rgba(232,213,181,0.72);
  color: #5C4A3A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(24rpx * var(--fs-scale, 1));
  font-weight: 700;
  letter-spacing: 1rpx;
  box-sizing: border-box;
}

.scene-tab + .scene-tab {
  margin-left: 14rpx;
}

.scene-tab.active {
  background: #B5452A;
  border-color: #B5452A;
  color: #E8D5B5;
  box-shadow: 0 8rpx 24rpx rgba(20,14,10,0.30);
}

.scene-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #C4935A;
}

.scene-tab.active .scene-dot {
  background: #E8D5B5;
}

.scene-name {
  min-width: 0;
  max-width: 146rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
