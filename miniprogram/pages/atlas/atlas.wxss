/* ============ 图鉴 �?对齐 H5 ?============ */
.page-atlas { background: #F8F2E8; min-height: 100vh; padding-bottom: 40rpx; }
.card-hover { opacity: 0.92; transform: scale(0.97); }

.atlas-hero {
  padding: 60rpx 40rpx 48rpx; text-align: center;
  background: linear-gradient(180deg, #2A1F14 0%, #3E2D1E 100%);
  color: #E8D5B5;
  position: relative; overflow: hidden;
}
.atlas-hero::before {
  content: ''; position: absolute; top: -80rpx; right: -80rpx;
  width: 280rpx; height: 280rpx; border-radius: 50%;
  background: rgba(196,147,90,0.08);
}
.atlas-title {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(56rpx * var(--fs-scale, 1)); letter-spacing: 12rpx; color: #E8D5B5;
  position: relative; z-index: 1;
}
.atlas-sub {
  font-size: calc(22rpx * var(--fs-scale, 1)); opacity: 0.75; letter-spacing: 6rpx;
  margin-top: 12rpx; position: relative; z-index: 1;
}
.atlas-poem {
  display: inline-block; margin-top: 28rpx; padding: 16rpx 32rpx;
  border-top: 2rpx solid rgba(196,147,90,0.3);
  border-bottom: 2rpx solid rgba(196,147,90,0.3);
  font-size: calc(24rpx * var(--fs-scale, 1)); letter-spacing: 4rpx; font-style: italic; opacity: 0.9;
  position: relative; z-index: 1;
}

.herb-grid {
  padding: 32rpx 40rpx; display: grid;
  grid-template-columns: 1fr 1fr; gap: 24rpx;
}
.herb-card {
  position: relative; overflow: hidden;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
  padding: 32rpx 20rpx; text-align: center;
}
.herb-card::before {
  content: ''; position: absolute; top: -40rpx; right: -40rpx;
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: rgba(74,124,89,0.08);
}
.herb-seq {
  position: absolute; top: 12rpx; left: 16rpx;
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(24rpx * var(--fs-scale, 1)); color: #B5452A; opacity: 0.6;
}
.herb-ic { display: flex; justify-content: center; margin: 12rpx 0 20rpx; }
.herb-name {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(36rpx * var(--fs-scale, 1)); letter-spacing: 6rpx; color: #2A1F14;
}
.herb-latin {
  font-size: calc(18rpx * var(--fs-scale, 1)); color: #8B7A6B; font-style: italic;
  letter-spacing: 2rpx; margin-top: 6rpx;
}
.herb-tag {
  display: inline-block; margin-top: 16rpx;
  font-size: calc(20rpx * var(--fs-scale, 1)); padding: 4rpx 16rpx; letter-spacing: 1rpx;
  background: rgba(74,124,89,0.1); color: #4A7C59; border-radius: 4rpx;
}

/* 详情抽屉 */
.mask { position: fixed; inset: 0; background: rgba(42,31,20,0.7); z-index: 199; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 200;
  max-height: 85vh; overflow-y: auto;
  background: #F8F2E8; border-radius: 24rpx 24rpx 0 0;
  animation: slideUp 0.3s ease;
}
.sheet-hero {
  padding: 60rpx 40rpx 40rpx; text-align: center;
  background: linear-gradient(180deg, #F8F2E8, #F0E5CC);
  border-radius: 24rpx 24rpx 0 0;
  position: relative;
}
.sh-close {
  position: absolute; top: 20rpx; right: 24rpx;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(0,0,0,0.08);
  display: flex; align-items: center; justify-content: center;
}
.sh-ic { display: flex; justify-content: center; margin-bottom: 16rpx; }
.sh-name {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(52rpx * var(--fs-scale, 1)); letter-spacing: 10rpx; color: #2A1F14;
}
.sh-latin {
  font-size: calc(22rpx * var(--fs-scale, 1)); color: #8B7A6B; font-style: italic;
  letter-spacing: 3rpx; margin-top: 8rpx;
}
.sh-body { padding: 32rpx 40rpx 60rpx; }
.sh-sec {
  padding: 24rpx 0; border-bottom: 2rpx dashed rgba(196,147,90,0.3);
}
.sh-sec:last-child { border-bottom: none; }
.sh-lbl {
  font-size: calc(22rpx * var(--fs-scale, 1)); color: #B5452A; font-weight: 700;
  letter-spacing: 4rpx; margin-bottom: 10rpx;
}
.sh-val {
  font-size: calc(26rpx * var(--fs-scale, 1)); color: #2A1F14; line-height: 1.8; letter-spacing: 1rpx;
}
.page-bottom { height: 40rpx; }
