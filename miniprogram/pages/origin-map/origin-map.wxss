/* ============ 道地地图 �?对齐 H5 ?============ */
.page-map { background: #F8F2E8; min-height: 100vh; padding-bottom: 40rpx; }

.map-hero { padding: 36rpx 40rpx 16rpx; text-align: center; }
.map-title {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(40rpx * var(--fs-scale, 1)); color: #2A1F14; letter-spacing: 6rpx;
}
.map-sub { font-size: calc(22rpx * var(--fs-scale, 1)); color: #8B7A6B; letter-spacing: 2rpx; margin-top: 8rpx; }

.map-stage {
  position: relative; margin: 16rpx 40rpx;
  aspect-ratio: 320/340; max-height: 800rpx;
}
.map-svg {
  position: absolute; inset: 0; width: 100%; height: 100%;
  display: block;
}
.map-pins { position: absolute; inset: 0; }

.map-pin {
  position: absolute; transform: translate(-50%, -100%);
  display: flex; flex-direction: column; align-items: center;
}
.map-pin .dot {
  width: 24rpx; height: 24rpx; border-radius: 50%;
  background: #B5452A; border: 4rpx solid #E8D5B5;
  box-shadow: 0 0 0 0 rgba(181,69,42,0.6);
  animation: pinPulse 1.8s ease-out infinite;
}
.map-pin .lbl {
  margin-top: 6rpx; padding: 3rpx 12rpx;
  background: rgba(42,31,20,0.85); color: #E8D5B5;
  border-radius: 4rpx; font-size: calc(18rpx * var(--fs-scale, 1)); letter-spacing: 1rpx; white-space: nowrap;
}
@keyframes pinPulse {
  0%   { box-shadow: 0 0 0 0 rgba(181,69,42,0.6); }
  70%  { box-shadow: 0 0 0 24rpx rgba(181,69,42,0); }
  100% { box-shadow: 0 0 0 0 rgba(181,69,42,0); }
}

.map-legend {
  padding: 20rpx 40rpx 12rpx;
  display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx;
}
.legend-item {
  padding: 16rpx 20rpx; background: #FFFCF5;
  border: 2rpx solid #E8D5B5; border-radius: 8rpx;
  display: flex; align-items: center; gap: 12rpx; font-size: calc(24rpx * var(--fs-scale, 1));
}
.legend-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #B5452A; flex-shrink: 0;
}
.legend-n { font-weight: 700; color: #2A1F14; letter-spacing: 1rpx; flex: 1; }
.legend-d { font-size: calc(18rpx * var(--fs-scale, 1)); color: #8B7A6B; }

/* 详情抽屉 */
.mask { position: fixed; inset: 0; background: rgba(42,31,20,0.7); z-index: 199; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 200;
  background: #FFFCF5; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 40rpx 60rpx;
  animation: slideUp 0.3s ease;
}
.sh-top {
  display: flex; align-items: center;
  padding-bottom: 20rpx; border-bottom: 2rpx solid #E8D5B5;
}
.sh-name {
  flex: 1; font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(36rpx * var(--fs-scale, 1)); color: #2A1F14; letter-spacing: 4rpx;
}
.sh-close { width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(0,0,0,0.08);
  display: flex; align-items: center; justify-content: center; }
.sh-row {
  display: flex; gap: 20rpx; padding: 20rpx 0;
  border-bottom: 2rpx dashed rgba(196,147,90,0.3);
}
.sh-row:last-child { border-bottom: none; }
.sh-row .k {
  width: 100rpx; color: #B5452A; font-size: calc(22rpx * var(--fs-scale, 1));
  font-weight: 700; letter-spacing: 2rpx;
}
.sh-row .v { flex: 1; color: #2A1F14; font-size: calc(26rpx * var(--fs-scale, 1)); line-height: 1.7; }
