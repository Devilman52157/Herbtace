/* ============ 溯源 �?对齐 H5 ?============ */
.trace-page { background: #F8F2E8; min-height: 100vh; padding-bottom: 60rpx; }

.trace-hero {
  position: relative; height: 400rpx;
  background: linear-gradient(170deg, #2A1F14, #3D2E1F);
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.trace-hero::after {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(circle at 50% 40%, rgba(196,147,90,0.15), transparent 70%);
}
.trace-inner { text-align: center; z-index: 1; color: #E8D5B5; }
.trace-inner .tic {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: rgba(232,213,181,0.12);
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 16rpx;
}
.tic-img { width: 100%; height: 100%; display: block; }
.tname {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(48rpx * var(--fs-scale, 1)); letter-spacing: 6rpx; color: #E8D5B5;
}
.tbatch { font-size: calc(22rpx * var(--fs-scale, 1)); opacity: 0.6; margin-top: 8rpx; letter-spacing: 2rpx; }
.bc { margin-top: 20rpx; }
.bc-badge {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 6rpx 20rpx; font-size: calc(22rpx * var(--fs-scale, 1));
  background: rgba(196,147,90,0.15); color: #E8D5B5;
  border: 2rpx solid rgba(196,147,90,0.4); border-radius: 999rpx;
  letter-spacing: 1rpx;
}
.bc-hash { font-size: calc(18rpx * var(--fs-scale, 1)); opacity: 0.5; margin-top: 10rpx; letter-spacing: 1rpx; }

/* VR 入口 */
.vr-card {
  margin: 32rpx 40rpx;
  background: linear-gradient(135deg, #2A1F14, #3D2E1F, #4A3828);
  color: #E8D5B5; border-radius: 12rpx; padding: 48rpx;
  display: flex; flex-direction: column; align-items: center;
  border: 2rpx solid rgba(196,147,90,0.15);
  position: relative; overflow: hidden; min-height: 200rpx;
}
.vr-card::before {
  content: ''; position: absolute;
  width: 200rpx; height: 200rpx;
  border: 2rpx solid rgba(196,147,90,0.12); border-radius: 50%;
  animation: vrP 3s ease-in-out infinite;
}
@keyframes vrP {
  0%,100% { transform: scale(1); opacity: 0.3; }
  50% { transform: scale(1.4); opacity: 0.08; }
}
.vrc-ic { margin-bottom: 14rpx; z-index: 1; }
.vrc-label { font-size: calc(28rpx * var(--fs-scale, 1)); font-weight: 700; letter-spacing: 4rpx; z-index: 1; }
.vrc-hint { font-size: calc(20rpx * var(--fs-scale, 1)); opacity: 0.5; margin-top: 8rpx; z-index: 1; letter-spacing: 1rpx; }

/* 信息?*/
.info-card {
  margin: 0 40rpx 20rpx; padding: 28rpx;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
  position: relative;
}
.info-card::before,
.info-card::after {
  content: ''; position: absolute; width: 18rpx; height: 18rpx;
  border-color: #B5452A; border-style: solid;
}
.info-card::before { top: -2rpx; left: -2rpx; border-width: 4rpx 0 0 4rpx; }
.info-card::after  { bottom: -2rpx; right: -2rpx; border-width: 0 4rpx 4rpx 0; }

.info-title {
  font-size: calc(26rpx * var(--fs-scale, 1)); font-weight: 700; color: #2A1F14;
  letter-spacing: 2rpx; margin-bottom: 16rpx;
  display: flex; align-items: center; gap: 10rpx;
}
.irow {
  display: flex; justify-content: space-between; padding: 14rpx 0;
  border-bottom: 2rpx solid rgba(196,147,90,0.1); font-size: calc(24rpx * var(--fs-scale, 1));
}
.irow:last-child { border-bottom: none; }
.ik { color: #8B7A6B; letter-spacing: 1rpx; }
.iv { color: #2A1F14; font-weight: 700; max-width: 60%; text-align: right; }
.iv.cert { color: #4A7C59; }

/* 分割 */
.divider {
  margin: 32rpx 40rpx 20rpx;
  display: flex; align-items: center; gap: 16rpx;
  font-size: calc(22rpx * var(--fs-scale, 1)); color: #8B7A6B; letter-spacing: 4rpx;
}
.divider::before,
.divider::after {
  content: ''; flex: 1; height: 2rpx; background: #E8D5B5;
}

/* 时间?*/
.timeline {
  padding: 0 40rpx 24rpx 112rpx;
  position: relative;
}
.tl-item {
  position: relative;
  padding: 0 0 44rpx 34rpx;
}
.tl-item:last-child { padding-bottom: 0; }
.tl-item::before {
  content: '';
  position: absolute;
  left: -44rpx;
  top: 38rpx;
  bottom: -6rpx;
  width: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(196,147,90,0.42), rgba(196,147,90,0.16));
}
.tl-item.done::before {
  background: linear-gradient(180deg, rgba(181,69,42,0.42), rgba(196,147,90,0.20));
}
.tl-item:last-child::before {
  display: none;
}
.tl-dot {
  position: absolute;
  left: -60rpx;
  top: 2rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #F8F2E8;
  border: 2rpx solid rgba(181,69,42,0.68);
  box-shadow: 0 0 0 8rpx rgba(255,252,245,0.92), 0 8rpx 18rpx rgba(92,74,58,0.10);
  box-sizing: border-box;
}
.tl-dot::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: transparent;
  transform: translate(-50%, -50%);
}
.tl-dot.done {
  border-color: #B5452A;
  background: #FFFCF5;
}
.tl-dot.done::after {
  background: #B5452A;
}
.tl-item.pending .tl-dot {
  border-color: rgba(181,69,42,0.55);
  background: #FFFCF5;
}
.tl-date { font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; letter-spacing: 1rpx; }
.tl-title { font-size: calc(26rpx * var(--fs-scale, 1)); font-weight: 700; margin-top: 4rpx; color: #2A1F14; letter-spacing: 1rpx; }
.tl-desc { font-size: calc(22rpx * var(--fs-scale, 1)); color: #5C4A3A; margin-top: 6rpx; line-height: 1.7; }

/* 视频/报告小标?*/
.tl-media {
  display: inline-flex; align-items: center; gap: 8rpx;
  margin-top: 12rpx; padding: 8rpx 18rpx;
  background: rgba(181,69,42,0.08);
  border: 2rpx solid rgba(181,69,42,0.2);
  border-radius: 999rpx;
  font-size: calc(20rpx * var(--fs-scale, 1)); color: #B5452A; letter-spacing: 1rpx;
}

/* 区块链溯源证书卡 */
.cert-wrap {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 16rpx; padding: 18rpx;
  background: linear-gradient(135deg, rgba(181,69,42,0.06), rgba(196,147,90,0.08));
  border: 2rpx solid rgba(181,69,42,0.25);
  border-radius: 12rpx;
  position: relative;
}
.cert-thumb {
  width: 80rpx; height: 100rpx; flex-shrink: 0;
  background: #FFFCF5;
  border: 2rpx solid #E8D5B5;
  border-radius: 6rpx;
  position: relative;
  display: flex; align-items: center; justify-content: center;
}
.cert-thumb .cert-lines {
  position: absolute; top: 14rpx; left: 10rpx; right: 10rpx;
  display: flex; flex-direction: column; gap: 6rpx;
}
.cert-thumb .cert-lines view {
  height: 4rpx; background: #E8D5B5; border-radius: 2rpx;
}
.cert-thumb .cert-lines view:nth-child(2) { width: 80%; }
.cert-thumb .cert-lines view:nth-child(4) { width: 60%; }
.cert-stamp {
  position: absolute; bottom: 10rpx; right: 8rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 2rpx solid #B5452A; color: #B5452A;
  font-size: calc(14rpx * var(--fs-scale, 1)); font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  transform: rotate(-15deg);
}
.cert-btn { flex: 1; min-width: 0; }
.cert-t {
  display: flex; align-items: center; gap: 8rpx;
  font-size: calc(24rpx * var(--fs-scale, 1)); font-weight: 700; color: #B5452A; letter-spacing: 1rpx;
}
.cert-s {
  font-size: calc(18rpx * var(--fs-scale, 1)); color: #8B7A6B;
  margin-top: 6rpx; line-height: 1.6; white-space: pre-line;
}
.cert-arrow {
  flex-shrink: 0;
  font-size: calc(36rpx * var(--fs-scale, 1)); color: #B5452A; font-weight: 300;
}

/* 底部按钮 */
.bottom { padding: 32rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); }
.btn-ghost {
  width: 100%; min-height: 88rpx; line-height: 1.4; padding: 18rpx 0;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid #B5452A; background: transparent;
  color: #B5452A; border-radius: 8rpx;
  font-size: calc(26rpx * var(--fs-scale, 1)); font-weight: 700; letter-spacing: 4rpx;
}
.btn-ghost::after { border: none; }
