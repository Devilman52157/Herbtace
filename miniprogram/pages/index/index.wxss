/* ============ 首页 �?对齐 H5 ?============ */
.page-home { padding-bottom: 40rpx; }

.card-hover { transform: scale(0.98); opacity: 0.9; }
.btn-hover  { transform: scale(0.97); }

/* ===== Hero（毛笔字 + 多层渐变 + 动画）===== */
.hero {
  position: relative; height: 560rpx;
  background: linear-gradient(135deg,
    #1A0F08 0%,
    #3D1F12 25%,
    #5C3420 50%,
    #4A3828 75%,
    #2A4030 100%);
  overflow: hidden; isolation: isolate;
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 48rpx;
}
.hero::before {
  content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 360rpx;
  background:
    radial-gradient(ellipse 80% 70% at 18% 100%, rgba(74,124,89,0.55), transparent 70%),
    radial-gradient(ellipse 70% 60% at 78% 100%, rgba(181,69,42,0.55), transparent 70%),
    radial-gradient(ellipse 50% 40% at 50% 100%, rgba(196,147,90,0.30), transparent 70%);
  z-index: 0; pointer-events: none;
}
/* 旋转 conic 光晕（朱砂→金驼→翠玉） */
.hero-glow {
  position: absolute; z-index: 0; pointer-events: none;
  width: 1000rpx; height: 1000rpx;
  top: -300rpx; right: -300rpx;
  background: conic-gradient(
    from 0deg,
    rgba(181,69,42,0.55),
    rgba(196,147,90,0.45),
    rgba(74,124,89,0.40),
    rgba(196,147,90,0.45),
    rgba(181,69,42,0.55)
  );
  filter: blur(50rpx); opacity: 1;
  animation: glow-rotate 18s linear infinite;
}
/* 云朵层 — 真正的云朵剪影，缓慢横向漂移 */
.hero-clouds {
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='720' height='200' viewBox='0 0 720 200'><g fill='%23E8D5B5'><path d='M40 130 C20 130 8 116 22 106 C14 90 36 78 52 86 C58 70 92 70 100 86 C112 74 138 78 142 96 C162 96 168 116 152 124 Z'/><path d='M310 100 C290 100 278 86 292 76 C284 60 306 48 322 56 C328 40 362 40 370 56 C382 44 408 48 412 66 C432 66 438 86 422 94 Z'/><path d='M540 150 C524 150 514 138 526 130 C520 116 540 108 552 116 C558 102 588 102 594 116 C604 106 626 110 630 124 C644 124 650 142 636 148 Z'/></g></svg>"),
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='560' height='160' viewBox='0 0 560 160'><g fill='%23FFE7A8'><path d='M70 100 C56 100 48 90 58 84 C52 72 70 64 80 70 C84 60 108 60 114 70 C124 62 142 66 144 80 C158 80 162 92 152 98 Z'/><path d='M340 60 C328 60 322 50 330 46 C324 36 344 30 352 36 C356 26 376 26 380 36 C388 30 402 34 404 44 C414 44 418 54 410 58 Z'/></g></svg>");
  background-repeat: repeat-x, repeat-x;
  background-size: 720rpx 200rpx, 560rpx 160rpx;
  background-position: 0% 35%, 0% 75%;
  opacity: 0.32;
  filter: blur(8rpx);
  mix-blend-mode: screen;
  animation: cloudDriftA 90s linear infinite,
             cloudPulse 10s ease-in-out infinite alternate;
}
/* 斜向 aurora 流光带 */
.hero-aurora {
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background: linear-gradient(115deg,
    transparent 20%,
    rgba(232,213,181,0.20) 40%,
    rgba(255,215,140,0.32) 50%,
    rgba(232,213,181,0.20) 60%,
    transparent 80%);
  background-size: 220% 220%;
  animation: aurora 6s linear infinite;
  mix-blend-mode: screen;
}
.hero-logo {
  flex-shrink: 0;
  width: calc(96rpx * var(--fs-scale, 1));
  height: calc(96rpx * var(--fs-scale, 1));
  margin-right: 18rpx;
  opacity: 0.98;
  transform-origin: 50% 60%;
  filter: drop-shadow(0 6rpx 18rpx rgba(196,147,90,0.45));
  animation: logoFloat 5s ease-in-out infinite alternate,
             logoGlow 4s ease-in-out infinite alternate;
}
/* 右上角"溯"水印 — 金色流光渐变 */
.hero-deco {
  position: absolute; z-index: 1;
  top: 36rpx; right: 36rpx;
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi","FangSong",serif;
  font-size: calc(180rpx * var(--fs-scale, 1)); line-height: 1;
  letter-spacing: 0;
  background: linear-gradient(120deg,
    #C4935A 0%,
    #E8D5B5 20%,
    #FFE7A8 40%,
    #F5C97A 55%,
    #E8D5B5 75%,
    #C4935A 100%);
  background-size: 220% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(232,213,181,0.32);
  animation: decoShimmer 5s linear infinite,
             decoBreathe 6s ease-in-out infinite alternate;
}
.hero-tag {
  position: relative; z-index: 2;
  display: inline-block; width: fit-content;
  background: rgba(181,69,42,0.18); color: #E8D5B5;
  font-size: calc(22rpx * var(--fs-scale, 1)); padding: 8rpx 28rpx;
  border: 2rpx solid rgba(196,147,90,0.45); border-radius: 999rpx;
  margin-bottom: 20rpx; letter-spacing: 4rpx;
  box-shadow: 0 0 0 0 rgba(196,147,90,0.35);
  animation: glowPulse 3s ease-in-out infinite alternate;
}
.hero-title {
  position: relative; z-index: 2;
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi","FangSong",serif;
  font-size: calc(72rpx * var(--fs-scale, 1)); line-height: 1.2;
  margin-bottom: 12rpx; letter-spacing: 8rpx; font-weight: 400;
  display: inline-flex; align-items: center; width: fit-content;
  filter: drop-shadow(0 4rpx 12rpx rgba(0,0,0,0.45));
}
.hero-sub {
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.45);
}
.ht-char {
  display: inline-block;
  background: linear-gradient(90deg,
    #E8D5B5 0%, #F5EDE0 25%, #C4935A 50%, #F5EDE0 75%, #E8D5B5 100%);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  opacity: 0;
  animation: shimmer 4s linear infinite, charIn 0.6s ease-out forwards;
}
.ht-char:nth-child(1) { animation-delay: 0s, 0.20s; }
.ht-char:nth-child(2) { animation-delay: 0s, 0.32s; }
.ht-char:nth-child(3) { animation-delay: 0s, 0.44s; }
.ht-char:nth-child(4) { animation-delay: 0s, 0.56s; }
.hero-sub {
  position: relative; z-index: 2;
  font-size: calc(26rpx * var(--fs-scale, 1)); color: rgba(232,213,181,0.62); letter-spacing: 4rpx;
}
.anim-in-1 { animation: glowPulse 3s ease-in-out infinite alternate, slideInUp 0.6s 0s ease-out backwards; }
.anim-in-3 { animation: slideInUp 0.6s 0.7s ease-out backwards; }

@keyframes aurora {
  0%   { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}
/* 双层云朵反向横向漂移，营造视差感 */
@keyframes cloudDriftA {
  0%   { background-position: 0% 35%,    0% 75%; }
  100% { background-position: 720rpx 35%, -560rpx 75%; }
}
@keyframes cloudPulse {
  0%   { opacity: 0.22; }
  100% { opacity: 0.45; }
}
@keyframes glow-rotate {
  0%   { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
@keyframes logoFloat {
  0%   { transform: translateY(0) rotate(-3deg); }
  50%  { transform: translateY(-12rpx) rotate(0deg); }
  100% { transform: translateY(-4rpx) rotate(3deg); }
}
@keyframes logoGlow {
  0%   { filter: drop-shadow(0 6rpx 14rpx rgba(196,147,90,0.30)); }
  100% { filter: drop-shadow(0 8rpx 28rpx rgba(196,147,90,0.65)); }
}
@keyframes decoShimmer {
  0%   { background-position: 0% 50%; }
  100% { background-position: 220% 50%; }
}
@keyframes decoBreathe {
  0%   { opacity: 0.75; -webkit-text-stroke-color: rgba(232,213,181,0.18); }
  100% { opacity: 1;    -webkit-text-stroke-color: rgba(255,231,168,0.45); }
}
@keyframes shimmer {
  0%   { background-position: 0% 0%; }
  100% { background-position: 200% 0%; }
}
@keyframes breathe {
  0%   { opacity: 0.05; }
  100% { opacity: 0.14; }
}
@keyframes glowPulse {
  0%   { box-shadow: 0 0 0 0 rgba(196,147,90,0.35); }
  100% { box-shadow: 0 0 18rpx 2rpx rgba(196,147,90,0.20); }
}
@keyframes slideInUp {
  0%   { opacity: 0; transform: translateY(30rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
@keyframes charIn {
  0%   { opacity: 0; transform: translateY(24rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* ===== 扫码按钮 ===== */
.scan-section { padding: 36rpx 40rpx 12rpx; }
.scan-btn {
  position: relative; overflow: hidden; isolation: isolate;
  width: 100%; padding: 32rpx 36rpx 26rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(135deg,
      #C4502E 0%,
      #B5452A 30%,
      #8C3420 60%,
      #B5452A 100%);
  background-size: 200% 200%;
  color: #FFE7A8;
  box-shadow:
    0 12rpx 36rpx rgba(181,69,42,0.42),
    0 4rpx 12rpx rgba(140,52,32,0.3),
    inset 0 2rpx 0 rgba(255,231,168,0.25),
    inset 0 -2rpx 0 rgba(0,0,0,0.18);
  animation: scanGradient 6s ease-in-out infinite alternate,
             scanPulse 2.4s ease-in-out infinite;
}
.scan-btn::before {
  content: ''; position: absolute; inset: 6rpx;
  border: 2rpx solid rgba(255,231,168,0.32); border-radius: 18rpx;
  pointer-events: none; z-index: 1;
}
/* 顶部高光 */
.scan-btn::after {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 50%;
  background: linear-gradient(to bottom, rgba(255,231,168,0.18), transparent);
  border-radius: 24rpx 24rpx 0 0;
  pointer-events: none; z-index: 1;
}
/* 流光扫过 */
.scan-btn-shine {
  position: absolute; top: 0; left: -60%; width: 50%; height: 100%;
  background: linear-gradient(115deg,
    transparent 30%,
    rgba(255,231,168,0.28) 45%,
    rgba(255,255,255,0.45) 50%,
    rgba(255,231,168,0.28) 55%,
    transparent 70%);
  transform: skewX(-20deg);
  animation: scanShine 3.5s ease-in-out infinite;
  pointer-events: none; z-index: 2;
}
.scan-btn-inner {
  position: relative; z-index: 3;
  display: flex; align-items: center; justify-content: center; gap: 18rpx;
}
.scan-btn-icon {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: rgba(255,231,168,0.18);
  border: 2rpx solid rgba(255,231,168,0.45);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 20rpx rgba(255,231,168,0.3);
}
.scan-txt {
  font-size: calc(34rpx * var(--fs-scale, 1));
  font-weight: 400; letter-spacing: 6rpx;
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi","FangSong",serif;
  background: linear-gradient(90deg, #FFE7A8 0%, #FFFFFF 50%, #FFE7A8 100%);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: scanTextShimmer 3s linear infinite;
}
.scan-btn-badge {
  position: relative; z-index: 3;
  margin-top: 10rpx; text-align: center;
  font-size: calc(20rpx * var(--fs-scale, 1));
  letter-spacing: 3rpx;
  color: rgba(255,231,168,0.7);
  font-family: "LXGW WenKai","Noto Serif SC","Songti SC","STSong",serif;
}

@keyframes scanGradient {
  0%   { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}
@keyframes scanPulse {
  0%, 100% {
    box-shadow:
      0 12rpx 36rpx rgba(181,69,42,0.42),
      0 4rpx 12rpx rgba(140,52,32,0.3),
      inset 0 2rpx 0 rgba(255,231,168,0.25),
      inset 0 -2rpx 0 rgba(0,0,0,0.18);
  }
  50% {
    box-shadow:
      0 16rpx 48rpx rgba(196,80,46,0.55),
      0 6rpx 18rpx rgba(140,52,32,0.4),
      inset 0 2rpx 0 rgba(255,231,168,0.35),
      inset 0 -2rpx 0 rgba(0,0,0,0.18);
  }
}
@keyframes scanShine {
  0%   { left: -60%; }
  60%  { left: 130%; }
  100% { left: 130%; }
}
@keyframes scanTextShimmer {
  0%   { background-position: 0% 0%; }
  100% { background-position: 200% 0%; }
}
/* ===== 分类三宫?===== */
/* ===== 分类横滑 ===== */
.cat-scroll { padding-left: 40rpx; white-space: nowrap; }
.cat-row { display: inline-flex; gap: 20rpx; padding-right: 40rpx; }
.cat-card {
  width: 164rpx; flex: 0 0 164rpx; background: #FFFCF5; border: 2rpx solid #E8D5B5;
  border-radius: 8rpx; padding: 28rpx 16rpx; text-align: center;
}
.cat-ic { margin: 0 auto 12rpx; display: flex; justify-content: center; }
.cat-name {
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi","FangSong",serif;
  font-size: calc(28rpx * var(--fs-scale, 1)); font-weight: 400; color: #2A1F14; letter-spacing: 4rpx;
}
.cat-sub  { font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; margin-top: 6rpx; letter-spacing: 2rpx; }

/* ===== 特色功能：六宫格?×3?===== */
.feat-grid {
  padding: 0 40rpx 8rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx;
}
.feat-card {
  position: relative; overflow: hidden;
  padding: 28rpx 28rpx 24rpx; border-radius: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.18); color: #FFF;
  box-shadow: 0 4rpx 14rpx rgba(60,50,40,0.08);
}
.feat-card::after {
  content: ''; position: absolute; right: -40rpx; bottom: -40rpx;
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: rgba(255,255,255,0.10);
}
.feat-ic {
  width: 56rpx; height: 56rpx; margin-bottom: 20rpx; opacity: 0.95;
  position: relative; z-index: 1; color: #FFFFFF;
}
.feat-name {
  position: relative; z-index: 1;
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi","FangSong",serif;
  font-size: calc(32rpx * var(--fs-scale, 1)); letter-spacing: 4rpx; color: #FFF; margin-bottom: 6rpx;
}
.feat-sub {
  position: relative; z-index: 1;
  font-size: calc(20rpx * var(--fs-scale, 1)); opacity: 0.85; letter-spacing: 1.5rpx;
}
/* 莫兰迪低饱和度色板：低饱和、灰调、雾感，避免视觉拥挤 */
.feat-atlas  { background: linear-gradient(135deg,#A47766,#8B5F4E); }  /* 雾陶 */
.feat-map    { background: linear-gradient(135deg,#8DA197,#728579); }  /* 鼠尾草绿 */
.feat-study  { background: linear-gradient(135deg,#B5A284,#94815E); }  /* 燕麦驼 */
.feat-ar     { background: linear-gradient(135deg,#8194A6,#65798B); }  /* 雾蓝 */
.feat-gift   { background: linear-gradient(135deg,#A5868D,#866872); }  /* 藕粉灰 */
.feat-points { background: linear-gradient(135deg,#A39576,#82765A); }  /* 黄褐橄榄 */

/* ===== 节气横滑 ===== */
.jieqi-strip { padding: 8rpx 40rpx 16rpx; white-space: nowrap; }
.jieqi-card {
  display: inline-block; vertical-align: top; width: 216rpx;
  margin-right: 20rpx; padding: 28rpx 20rpx 24rpx;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
  text-align: center; position: relative;
  overflow: hidden; isolation: isolate;
  box-shadow: 0 2rpx 6rpx rgba(42,31,20,0.04);
}
.jieqi-card.past { opacity: 0.52; }
.jieqi-card.current {
  border: 3rpx solid #B5452A;
  box-shadow: 0 8rpx 28rpx rgba(181,69,42,0.20);
  animation: jqCurrentGlow 3s ease-in-out infinite alternate;
}
.jq-badge {
  position: absolute; top: 10rpx; right: 10rpx; z-index: 8;
  background: #B5452A; color: #E8D5B5;
  font-size: calc(18rpx * var(--fs-scale, 1)); font-weight: 700;
  line-height: 1.2;
  padding: 5rpx 12rpx; border-radius: 999rpx; letter-spacing: 1rpx;
  border: 2rpx solid rgba(232,213,181,0.62);
  box-shadow: 0 4rpx 12rpx rgba(181,69,42,0.35);
  white-space: nowrap;
}
.jq-iconwrap {
  width: 72rpx; height: 72rpx; margin: 0 auto 12rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #EDE4D4; border: 2rpx solid #E8D5B5;
  position: relative; z-index: 2;
}
.jq-name {
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi","FangSong",serif;
  font-size: calc(34rpx * var(--fs-scale, 1)); color: #2A1F14; letter-spacing: 4rpx;
  position: relative; z-index: 2;
}
.jq-date { font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; margin-top: 4rpx; letter-spacing: 1rpx; position: relative; z-index: 2; }
.jq-poem {
  font-size: calc(22rpx * var(--fs-scale, 1)); color: #5C4A3A; margin-top: 12rpx; line-height: 1.5;
  letter-spacing: 1rpx; min-height: 64rpx;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  white-space: normal;
  position: relative; z-index: 2;
}

/* ===== 季节主题（应用全部 24 张卡） ===== */
.jieqi-card.jieqi-spring {
  background: linear-gradient(160deg, #FFFCF5 0%, #EAF3EC 100%);
  border-color: #C8DCC8;
}
.jieqi-card.jieqi-spring .jq-iconwrap {
  background: #FFFFFF; border-color: #6B9E78;
}
.jieqi-card.jieqi-spring .jq-name { color: #2C4A35; }

.jieqi-card.jieqi-summer {
  background: linear-gradient(160deg, #FFFCF5 0%, #FCEBE0 100%);
  border-color: #F0C7B0;
}
.jieqi-card.jieqi-summer .jq-iconwrap {
  background: #FFFFFF; border-color: #D4633C;
}
.jieqi-card.jieqi-summer .jq-name { color: #6B2818; }

.jieqi-card.jieqi-autumn {
  background: linear-gradient(160deg, #FFFCF5 0%, #F5EDE0 100%);
  border-color: #E0C896;
}
.jieqi-card.jieqi-autumn .jq-iconwrap {
  background: #FFFFFF; border-color: #C4935A;
}
.jieqi-card.jieqi-autumn .jq-name { color: #5C4222; }

.jieqi-card.jieqi-winter {
  background: linear-gradient(160deg, #FFFCF5 0%, #E5ECEF 100%);
  border-color: #C0CCD2;
}
.jieqi-card.jieqi-winter .jq-iconwrap {
  background: #FFFFFF; border-color: #5C6F7A;
}
.jieqi-card.jieqi-winter .jq-name { color: #2A3942; }

/* current 状态加深背景，覆盖 past/future */
.jieqi-card.current.jieqi-spring { background: linear-gradient(160deg, #F5FBF6 0%, #D5EADC 100%); }
.jieqi-card.current.jieqi-summer { background: linear-gradient(160deg, #FFF6EE 0%, #F8D9C5 100%); }
.jieqi-card.current.jieqi-autumn { background: linear-gradient(160deg, #FBF6EB 0%, #ECDBB8 100%); }
.jieqi-card.current.jieqi-winter { background: linear-gradient(160deg, #F2F6F8 0%, #CFDADF 100%); }

/* ===== 春 · 嫩芽萌发：底部绿光升起 + 三粒花瓣上飘 ===== */
.jieqi-card.current.jieqi-spring::before,
.jieqi-card.future.jieqi-spring::before {
  content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: radial-gradient(ellipse 90% 60% at 50% 110%, rgba(107,158,120,0.45), transparent 70%);
  animation: springRise 3.5s ease-in-out infinite alternate;
}
.jieqi-card.current.jieqi-spring::after,
.jieqi-card.future.jieqi-spring::after {
  content: ''; position: absolute; left: 50%; bottom: 0; z-index: 1;
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #6B9E78;
  box-shadow:
    -60rpx 0 0 -1rpx rgba(107,158,120,0.85),
     56rpx 8rpx 0 0 rgba(74,124,89,0.75),
    -20rpx -10rpx 0 -2rpx rgba(168,201,165,0.9);
  animation: springFloat 4.5s ease-in-out infinite;
  pointer-events: none;
}

/* ===== 夏 · 烈日辐射：icon 圈外脉冲 + 中心暖光 ===== */
.jieqi-card.current.jieqi-summer::before,
.jieqi-card.future.jieqi-summer::before {
  content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: radial-gradient(circle 200rpx at 50% 30%, rgba(212,99,60,0.30), transparent 75%);
}
.jieqi-card.current.jieqi-summer .jq-iconwrap,
.jieqi-card.future.jieqi-summer .jq-iconwrap {
  animation: summerPulse 2.2s ease-in-out infinite;
}

/* ===== 秋 · 金叶飘落：三粒金色光斑下落 ===== */
.jieqi-card.current.jieqi-autumn::before,
.jieqi-card.future.jieqi-autumn::before {
  content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: linear-gradient(180deg, rgba(196,147,90,0.18) 0%, transparent 50%);
}
.jieqi-card.current.jieqi-autumn::after,
.jieqi-card.future.jieqi-autumn::after {
  content: ''; position: absolute; left: 30%; top: 0; z-index: 1;
  width: 10rpx; height: 10rpx; border-radius: 2rpx;
  background: #C4935A;
  box-shadow:
     50rpx 20rpx 0 -2rpx rgba(196,147,90,0.85),
    100rpx 60rpx 0 -1rpx rgba(212,167,110,0.75),
     20rpx 90rpx 0 -3rpx rgba(168,124,76,0.8);
  animation: autumnFall 5s linear infinite;
  pointer-events: none;
}

/* ===== 冬 · 雪花闪烁：冷色雪点 + 冷色微光（全状态生效，含 past） ===== */
.jieqi-card.jieqi-winter::before {
  content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background:
    radial-gradient(circle 6rpx at 18% 18%, #6B8CA0, transparent 70%),
    radial-gradient(circle 7rpx at 78% 28%, #5C7A8F, transparent 70%),
    radial-gradient(circle 5rpx at 32% 48%, #7A98AE, transparent 70%),
    radial-gradient(circle 6rpx at 62% 60%, #5C7A8F, transparent 70%),
    radial-gradient(circle 5rpx at 22% 78%, #6B8CA0, transparent 70%),
    radial-gradient(circle 6rpx at 82% 82%, #7A98AE, transparent 70%),
    linear-gradient(135deg, transparent 55%, rgba(108,140,160,0.22) 100%);
  animation: winterTwinkle 2.4s ease-in-out infinite;
}
.jieqi-card.jieqi-winter::after {
  content: ''; position: absolute; left: 20%; top: 0; z-index: 1;
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #5C7A8F;
  box-shadow:
     50rpx 20rpx 0 -1rpx rgba(107,140,160,0.90),
    100rpx 50rpx 0 -2rpx rgba(92,122,143,0.85),
     30rpx 90rpx 0 -2rpx rgba(122,152,174,0.85),
     80rpx 130rpx 0 -1rpx rgba(92,122,143,0.80),
     20rpx 160rpx 0 -2rpx rgba(107,140,160,0.85);
  animation: winterFall 6s linear infinite;
  pointer-events: none;
}

/* ===== 今日精产品卡 ===== */
.product-list { padding: 0 40rpx; display: flex; flex-direction: column; gap: 24rpx; }
.product-card {
  background: #FFFCF5; border: 2rpx solid #E8D5B5;
  border-radius: 8rpx; padding: 28rpx;
  display: flex; gap: 24rpx;
  align-items: center;
}
.p-thumb {
  width: 200rpx; height: 200rpx;
  flex-shrink: 0;
  background: #FFFFFF; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.p-img { width: 100%; height: 100%; display: block; }
.p-body {
  flex: 1; display: flex; flex-direction: column;
  justify-content: space-between; gap: 8rpx; min-width: 0;
}
.p-name {
  font-family: "LXGW WenKai","Kaiti SC","STKaiti","KaiTi","FangSong",serif;
  font-size: calc(28rpx * var(--fs-scale, 1));
  font-weight: 500; color: #2A1F14; letter-spacing: 2rpx;
  line-height: 1.3;
}
.p-origin {
  font-size: calc(22rpx * var(--fs-scale, 1)); color: #8B7A6B;
  display: flex; align-items: center; gap: 6rpx;
}
.p-tags { display: flex; flex-wrap: wrap; gap: 8rpx; min-width: 0; }
.p-tags .tag { margin-right: 0; }
.p-price-row {
  display: flex; justify-content: flex-end; align-items: baseline;
  margin-top: 4rpx;
}
.p-price {
  font-size: calc(32rpx * var(--fs-scale, 1)); color: #B5452A; font-weight: 700;
  white-space: nowrap;
}
.p-unit { font-size: calc(20rpx * var(--fs-scale, 1)); font-weight: 400; }

.foot-more {
  text-align: center; padding: 32rpx;
  color: #4A7C59; font-size: calc(24rpx * var(--fs-scale, 1)); letter-spacing: 3rpx;
}
.page-bottom { height: 40rpx; }

/* ===== 进入小程序登录弹层 ===== */
.login-modal {
  position: fixed;
  inset: 0;
  z-index: 980;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  animation: fadeIn 0.22s ease-out both;
}

.login-mask {
  position: absolute;
  inset: 0;
  background: rgba(42,31,20,0.58);
  backdrop-filter: blur(8px);
}

.login-sheet {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 88vh;
  overflow: auto;
  padding: 0 34rpx 32rpx;
  background: #FFFCF5;
  border: 2rpx solid #E8D5B5;
  border-radius: 16rpx;
  box-shadow: 0 28rpx 72rpx rgba(26,15,8,0.34);
  animation: loginSheetIn 0.28s ease-out both;
}

.login-sheet::before {
  content: '';
  position: absolute;
  inset: 0 0 auto;
  height: 210rpx;
  background:
    radial-gradient(circle 170rpx at 18% 18%, rgba(196,147,90,0.22), transparent 72%),
    radial-gradient(circle 190rpx at 84% 22%, rgba(74,124,89,0.16), transparent 72%),
    linear-gradient(135deg, #2A1F14, #5C3420 54%, #2A4030);
  pointer-events: none;
}

.login-sheet::after {
  content: '';
  position: absolute;
  top: 30rpx;
  right: 38rpx;
  width: 174rpx;
  height: 120rpx;
  opacity: 0.16;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='260' height='130' viewBox='0 0 260 130'><g fill='none' stroke='%23E8D5B5' stroke-width='4' stroke-linecap='round'><path d='M15 82c30-42 63-42 94 0 31 42 63 42 94 0'/><path d='M52 52c20-26 43-26 66 0 24 27 47 27 70 0'/><path d='M96 99c19-19 39-19 60 0'/></g></svg>");
  background-size: 100% 100%;
  pointer-events: none;
}

.login-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 3;
  width: 62rpx;
  height: 62rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,252,245,0.88);
  border: 2rpx solid rgba(232,213,181,0.8);
  border-radius: 50%;
}

.login-icon-hover {
  opacity: 0.76;
}

.login-sheet-head {
  position: relative;
  z-index: 2;
  min-height: 282rpx;
  padding: 46rpx 72rpx 28rpx 0;
  color: #E8D5B5;
}

.login-sheet-logo {
  position: absolute;
  right: 92rpx;
  top: 52rpx;
  width: 130rpx;
  height: 110rpx;
  opacity: 0.22;
}

.login-seal-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: rgba(181,69,42,0.42);
  border: 3rpx solid #C4935A;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: inset 0 2rpx 0 rgba(255,231,168,0.18);
}

.login-kicker {
  width: fit-content;
  padding: 6rpx 18rpx;
  border: 2rpx solid rgba(196,147,90,0.52);
  border-radius: 999rpx;
  background: rgba(181,69,42,0.14);
  color: rgba(232,213,181,0.82);
  font-size: calc(20rpx * var(--fs-scale, 1));
  letter-spacing: 4rpx;
}

.login-title {
  margin-top: 14rpx;
  font-size: calc(54rpx * var(--fs-scale, 1));
  line-height: 1.12;
  letter-spacing: 8rpx;
  color: #E8D5B5;
}

.login-subtitle {
  margin-top: 12rpx;
  color: rgba(232,213,181,0.72);
  font-size: calc(24rpx * var(--fs-scale, 1));
  letter-spacing: 2rpx;
  line-height: 1.45;
}

.login-benefit-list {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  border: 2rpx solid rgba(232,213,181,0.76);
  border-radius: 12rpx;
  background: rgba(248,242,232,0.68);
  overflow: hidden;
}

.login-benefit-item {
  min-height: 82rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 2rpx solid rgba(196,147,90,0.14);
  color: #5C4A3A;
  font-size: calc(24rpx * var(--fs-scale, 1));
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.login-benefit-item:last-child {
  border-bottom: none;
}

.login-benefit-ic {
  width: 54rpx;
  height: 54rpx;
  border-radius: 10rpx;
  flex: 0 0 54rpx;
  background: #FFFCF5;
  border: 2rpx solid rgba(196,147,90,0.24);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-wechat-btn {
  position: relative;
  z-index: 2;
  margin-top: 28rpx;
  padding: 0;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 12rpx;
  color: #FFE7A8;
  background: linear-gradient(135deg, #C4502E, #B5452A 52%, #8C3420);
  box-shadow: 0 10rpx 26rpx rgba(181,69,42,0.28);
}

.login-wechat-btn[disabled] {
  opacity: 0.72;
}

.login-wechat-inner {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: calc(30rpx * var(--fs-scale, 1));
  font-weight: 700;
  letter-spacing: 4rpx;
}

.login-btn-hover {
  opacity: 0.9;
}

.login-later {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  padding: 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background: transparent;
  border: 2rpx solid #E8D5B5;
  color: #8B7A6B;
  font-size: calc(24rpx * var(--fs-scale, 1));
  letter-spacing: 2rpx;
}

.login-later-hover {
  background: #F5EDE0;
}

.login-note {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #8B7A6B;
  font-size: calc(21rpx * var(--fs-scale, 1));
  letter-spacing: 1rpx;
}

@keyframes loginSheetIn {
  0% { opacity: 0; transform: translateY(36rpx) scale(0.98); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* ===== 当令节气动效 keyframes ===== */
@keyframes jqCurrentGlow {
  0%   { box-shadow: 0 6rpx 20rpx rgba(181,69,42,0.18); }
  100% { box-shadow: 0 12rpx 36rpx rgba(181,69,42,0.40); }
}
@keyframes springRise {
  0%   { opacity: 0.55; transform: translateY(8rpx); }
  100% { opacity: 1;    transform: translateY(-4rpx); }
}
@keyframes springFloat {
  0%   { transform: translate(-50%, 0) scale(1);   opacity: 0; }
  20%  { opacity: 1; }
  80%  { opacity: 0.8; }
  100% { transform: translate(-50%, -260rpx) scale(0.6); opacity: 0; }
}
@keyframes summerPulse {
  0%, 100% {
    box-shadow:
      0 0 0 0    rgba(212,99,60,0.55),
      0 0 0 0    rgba(245,201,122,0.35);
  }
  50% {
    box-shadow:
      0 0 0 14rpx rgba(212,99,60,0),
      0 0 0 28rpx rgba(245,201,122,0);
  }
}
@keyframes autumnFall {
  0%   { transform: translateY(-20rpx) rotate(0deg);  opacity: 0; }
  15%  { opacity: 1; }
  85%  { opacity: 0.9; }
  100% { transform: translateY(220rpx) rotate(80deg); opacity: 0; }
}
@keyframes winterTwinkle {
  0%, 100% { opacity: 0.35; }
  50%      { opacity: 1; }
}
@keyframes winterFall {
  0%   { transform: translateY(-20rpx); opacity: 0; }
  20%  { opacity: 1; }
  80%  { opacity: 0.9; }
  100% { transform: translateY(220rpx); opacity: 0; }
}
