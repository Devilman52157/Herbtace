<view class="{{appFontClass}} page-home">

  <!-- Hero：毛笔字"云上祁州" + 右下扫码入口 -->
  <view class="hero">
    <view class="hero-aurora"></view>
    <view class="hero-glow"></view>
    <view class="hero-clouds"></view>
    <view class="hero-deco">溯</view>
    <view class="hero-tag anim-in-1">壹 · 康养溯源</view>
    <view class="hero-title anim-in-2">
      <image class="hero-logo" src="/assets/brand/logo-cloud-light.png" mode="aspectFit"/>
      <text class="ht-char">云</text>
      <text class="ht-char">上</text>
      <text class="ht-char">祁</text>
      <text class="ht-char">州</text>
    </view>
    <view class="hero-sub anim-in-3">扫一下，溯源安国好材，解锁轻养茶方</view>
  </view>

  <!-- 扫码按钮 -->
  <view class="scan-section">
    <view class="scan-btn" bindtap="onScan" hover-class="btn-hover">
      <view class="scan-btn-shine"></view>
      <view class="scan-btn-inner">
        <view class="scan-btn-icon"><icon name="scan" size="44rpx" color="#FFE7A8"/></view>
        <text class="scan-txt">扫码溯源</text>
      </view>
      <view class="scan-btn-badge">每味药材 · 一码可溯</view>
    </view>
  </view>

  <!-- 分类 -->
  <view class="divider"><text class="label">逛一逛</text></view>
  <scroll-view scroll-x class="cat-scroll" enhanced show-scrollbar="{{false}}">
    <view class="cat-row">
      <view class="cat-card" wx:for="{{cats}}" wx:key="id"
            data-cat="{{item.id}}" bindtap="goShop" hover-class="card-hover">
        <view class="cat-ic"><icon name="{{item.icon}}" size="56rpx" color="#5C4A3A"/></view>
        <view class="cat-name">{{item.name}}</view>
        <view class="cat-sub">{{item.sub}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 特色功能：六宫格渐变卡片 -->
  <view class="divider"><text class="label">本草秘境</text></view>
  <view class="feat-grid">
    <view class="feat-card feat-{{item.id}}" wx:for="{{features}}" wx:key="id"
          data-id="{{item.id}}" bindtap="goFeat" hover-class="card-hover">
      <view class="feat-ic"><icon name="{{item.icon}}" size="56rpx" color="#FFFFFF"/></view>
      <view class="feat-name">{{item.name}}</view>
      <view class="feat-sub">{{item.sub}}</view>
    </view>
  </view>

  <!-- 节气养生 -->
  <view class="divider"><text class="label">节气养生</text></view>
  <scroll-view scroll-x class="jieqi-strip" enhanced show-scrollbar="{{false}}" scroll-into-view="{{currentJieqiViewId}}" scroll-with-animation>
    <view class="jieqi-card jieqi-{{item.season}} {{item.status}}"
          wx:for="{{jieqiList}}" wx:key="id"
          id="jieqi-{{item.id}}"
          data-id="{{item.id}}" bindtap="goJieqi">
      <view wx:if="{{item.status==='current'}}" class="jq-badge">当令</view>
      <view class="jq-iconwrap">
        <icon name="{{item.icon}}" size="36rpx" color="{{item.iconColor}}"/>
      </view>
      <view class="jq-name">{{item.name}}</view>
      <view class="jq-date">{{item.dateRange}}</view>
      <view class="jq-poem">{{item.poem}}</view>
    </view>
  </scroll-view>

  <!-- 今日精选 -->
  <view class="divider"><text class="label">今日精选</text></view>
  <view class="product-list">
    <view class="product-card" wx:for="{{picks}}" wx:key="id"
          data-id="{{item.id}}" bindtap="goTrace" hover-class="card-hover">
      <view class="p-thumb">
        <image wx:if="{{item.thumb || item.image}}" class="p-img"
               src="{{item.thumb ? item.thumb : item.image}}"
               mode="aspectFit"
               lazy-load="{{index > 1}}"/>
        <icon wx:else name="{{item.cat==='easy'?'tea':item.cat==='home'?'sprout':'gift'}}" size="72rpx" color="#4A7C59"/>
      </view>
      <view class="p-body">
        <view class="p-name">{{item.name}}</view>
        <view class="p-origin">
          <icon name="pin" size="22rpx" color="#8B7A6B"/>
          <text>{{item.origin}}</text>
        </view>
        <view class="p-tags">
          <text class="tag {{index%3===0?'j':index%3===1?'':'r'}}"
                wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
        <view class="p-price-row">
          <view class="p-price">¥{{item.price}}<text class="p-unit">/{{item.unit}}</text></view>
        </view>
      </view>
    </view>
  </view>

  <view class="foot-more" bindtap="goShop" data-cat="all">查看全部商品 </view>
  <view class="page-bottom"></view>
</view>
