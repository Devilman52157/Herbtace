/* ============ 我的 �?对齐 H5 ?============ */
.my-page { background: #F8F2E8; min-height: 100vh; padding-bottom: 40rpx; }

/* 顶部深色 header */
.my-header {
  position: relative; overflow: hidden;
  padding: 80rpx 48rpx 80rpx;
  background: linear-gradient(170deg,#2A1F14,#3D2E1F);
  color: #E8D5B5;
}
.my-header::after {
  content: ''; position: absolute; top: 20rpx; right: 32rpx;
  width: 160rpx; height: 160rpx;
  border: 4rpx solid rgba(196,147,90,0.06); border-radius: 50%;
}
.my-brand-mark {
  position: absolute; top: 48rpx; right: 40rpx; z-index: 0;
  width: 168rpx; height: 150rpx;
  opacity: 0.18;
}
.my-avatar {
  position: relative; z-index: 1;
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: rgba(181,69,42,0.4); border: 4rpx solid #C4935A;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.my-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.my-name {
  position: relative; z-index: 1;
  font-family: "Ma Shan Zheng","STKaiti","KaiTi",serif;
  font-size: calc(44rpx * var(--fs-scale, 1)); letter-spacing: 4rpx;
}
.my-id {
  position: relative; z-index: 1;
  font-size: calc(22rpx * var(--fs-scale, 1)); opacity: 0.5; margin-top: 4rpx; letter-spacing: 1rpx;
}
.my-login-chip {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(181,69,42,0.55);
  border: 2rpx solid rgba(196,147,90,0.72);
  color: #E8D5B5;
  font-size: calc(23rpx * var(--fs-scale, 1));
  letter-spacing: 2rpx;
}
.my-login-chip.logged {
  background: rgba(74,124,89,0.35);
}

/* 统计条（上移?header 之上，带四角装饰*/
.my-stats {
  position: relative; margin: -32rpx 40rpx 0;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
  display: flex;
}
.my-stats::before, .my-stats::after {
  content: ''; position: absolute; width: 16rpx; height: 16rpx;
  border-color: #B5452A; border-style: solid;
}
.my-stats::before { top: -2rpx; left: -2rpx; border-width: 4rpx 0 0 4rpx; }
.my-stats::after  { bottom: -2rpx; right: -2rpx; border-width: 0 4rpx 4rpx 0; }

.my-stat {
  flex: 1; text-align: center; padding: 28rpx 16rpx;
  border-right: 2rpx solid #E8D5B5;
}
.my-stat:last-child { border-right: none; }
.my-stat-num { font-size: calc(40rpx * var(--fs-scale, 1)); font-weight: 900; color: #B5452A; letter-spacing: 1rpx; }
.my-stat-lbl { font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; margin-top: 4rpx; letter-spacing: 1rpx; }

.my-coupon {
  margin: 28rpx 40rpx 0;
  padding: 26rpx 28rpx;
  background: linear-gradient(135deg, #FFFCF5 0%, #FBE8E4 100%);
  border: 2rpx solid #E8D5B5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(92,74,58,0.06);
}
.my-coupon-ic {
  width: 78rpx;
  height: 78rpx;
  border-radius: 18rpx;
  background: rgba(181,69,42,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 78rpx;
}
.my-coupon-body { flex: 1; min-width: 0; }
.my-coupon-title {
  font-size: calc(28rpx * var(--fs-scale, 1));
  font-weight: 700;
  color: #2A1F14;
  letter-spacing: 1rpx;
}
.my-coupon-desc {
  margin-top: 6rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  color: #8B7A6B;
  letter-spacing: 1rpx;
}
.my-coupon-count {
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #B5452A;
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(24rpx * var(--fs-scale, 1));
  font-weight: 700;
}
.my-coupon-arrow {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
}

/* 菜单列表 */
.my-menu {
  margin: 32rpx 40rpx 0; padding: 8rpx 32rpx;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
}
.my-menu-item {
  display: flex; align-items: center; gap: 24rpx;
  padding: 32rpx 0;
  border-bottom: 2rpx solid rgba(196,147,90,0.1);
}
.my-menu-item:last-child { border-bottom: none; }
.mi-ic {
  width: 56rpx; height: 56rpx; border-radius: 10rpx;
  background: rgba(196,147,90,0.1);
  display: flex; align-items: center; justify-content: center;
}
.my-menu-text { flex: 1; font-size: calc(26rpx * var(--fs-scale, 1)); color: #2A1F14; letter-spacing: 1rpx; }
.my-menu-arrow { width: 28rpx; height: 28rpx; }
.mi-hover { background: #F5EDE0; }

.hover-dim { opacity: 0.85; }
