/* ============ 商城 �?对齐 H5 ?============ */
.shop-page { background: #F8F2E8; min-height: 100vh; padding-bottom: 40rpx; }

/* ===== 搜索 ===== */
.shop-search {
  margin: 28rpx 40rpx 0; height: 76rpx; padding: 0 28rpx;
  display: flex; align-items: center; gap: 16rpx;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 999rpx;
  box-shadow: 0 2rpx 6rpx rgba(139,122,107,0.08);
}
.ss-input {
  flex: 1; min-width: 0; font-size: calc(26rpx * var(--fs-scale, 1)); color: #2A1F14;
  min-height: calc(48rpx * var(--fs-scale, 1)); line-height: 1.4;
  letter-spacing: 1rpx;
}
.ss-input-placeholder { color: #8B7A6B; font-size: calc(26rpx * var(--fs-scale, 1)); }
.ss-clear {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(139,122,107,0.15);
  display: flex; align-items: center; justify-content: center;
}

/* ===== 限时促销 ===== */
.promo-banner {
  position: relative; overflow: hidden;
  margin: 24rpx 40rpx 0; padding: 28rpx 32rpx; border-radius: 20rpx;
  background: linear-gradient(135deg,#B5452A,#D4694E);
  color: #E8D5B5;
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 8rpx 28rpx rgba(181,69,42,0.25);
}
.promo-banner::before {
  content: ''; position: absolute; right: -48rpx; top: -48rpx;
  width: 180rpx; height: 180rpx; border-radius: 50%;
  background: rgba(255,255,255,0.1);
}
.promo-banner::after {
  content: ''; position: absolute; right: 80rpx; bottom: -72rpx;
  width: 136rpx; height: 136rpx; border-radius: 50%;
  background: rgba(255,255,255,0.06);
}
.promo-left { position: relative; z-index: 1; }
.promo-tag {
  display: inline-block; padding: 4rpx 16rpx;
  background: #E8D5B5; color: #B5452A;
  font-size: calc(20rpx * var(--fs-scale, 1)); font-weight: 900; letter-spacing: 3rpx;
  border-radius: 6rpx; margin-bottom: 14rpx;
}
.promo-title {
  font-family: "Ma Shan Zheng","STKaiti","KaiTi",serif;
  font-size: calc(38rpx * var(--fs-scale, 1)); color: #FFF; letter-spacing: 5rpx; margin-bottom: 8rpx;
}
.promo-sub { font-size: calc(22rpx * var(--fs-scale, 1)); opacity: 0.88; letter-spacing: 1.6rpx; }
.promo-right { position: relative; z-index: 1; text-align: center; }
.promo-count {
  font-family: "Courier New", monospace;
  font-size: calc(28rpx * var(--fs-scale, 1)); font-weight: 900; color: #FFF;
  display: flex; align-items: center; gap: 8rpx;
}
.pn {
  display: inline-block; min-width: 56rpx; padding: 12rpx 18rpx;
  background: rgba(0,0,0,0.22); border-radius: 8rpx; text-align: center;
  letter-spacing: 1rpx;
}
.pc { opacity: 0.7; padding: 0 2rpx; }

/* ===== 分类 pill tabs ===== */
.shop-tabs {
  padding: 32rpx 40rpx 0; white-space: nowrap;
}
.shop-tab {
  display: inline-flex; align-items: center; gap: 8rpx;
  flex-shrink: 0; padding: 12rpx 28rpx; margin-right: 16rpx;
  font-size: calc(24rpx * var(--fs-scale, 1)); color: #8B7A6B; letter-spacing: 2rpx;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 999rpx;
}
.shop-tab.active {
  background: #B5452A; color: #FFF; border-color: #B5452A; font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(181,69,42,0.22);
}
.shop-tab-num { font-size: calc(20rpx * var(--fs-scale, 1)); opacity: 0.65; font-weight: 400; }
.shop-tab.active .shop-tab-num { opacity: 0.85; }

/* ===== 排序 ===== */
.shop-sort {
  padding: 28rpx 40rpx 12rpx; display: flex; align-items: center; gap: 20rpx;
  flex-wrap: wrap;
}
.shop-sort-lbl { font-size: calc(22rpx * var(--fs-scale, 1)); color: #8B7A6B; letter-spacing: 3rpx; }
.sort-opt {
  position: relative; font-size: calc(24rpx * var(--fs-scale, 1)); color: #8B7A6B; letter-spacing: 1rpx;
  padding: 4rpx 0;
}
.sort-opt.active { color: #B5452A; font-weight: 700; }
.sort-opt.active::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: -10rpx;
  height: 3rpx; background: #B5452A;
}
.shop-count { margin-left: auto; font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; letter-spacing: 1rpx; }

/* ===== 商品栅格?列）===== */
.shop-grid {
  padding: 24rpx 40rpx 40rpx;
  display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx;
}
.shop-item {
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
  overflow: hidden;
  animation: slideUp .4s ease both;
}
.shop-item-img {
  position: relative;
  height: 240rpx; background: #EDE4D4;
  border-bottom: 2rpx solid #E8D5B5;
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.shop-product-img { width: 100%; height: 100%; display: block; }
.shop-promo-tag {
  position: absolute; top: 12rpx; left: 12rpx; z-index: 1;
  padding: 4rpx 12rpx; background: #B5452A; color: #FFF;
  font-size: calc(18rpx * var(--fs-scale, 1)); font-weight: 900; letter-spacing: 2rpx;
  border-radius: 6rpx;
  box-shadow: 0 4rpx 8rpx rgba(181,69,42,0.3);
}
.shop-promo-tag.sale { background: #D4633C; }
.shop-item-fav {
  position: absolute; top: 10rpx; right: 10rpx;
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: rgba(255,255,255,0.94);
  border: 1rpx solid rgba(196,147,90,0.45);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(42,31,20,0.14);
  backdrop-filter: blur(2rpx);
}
.shop-item-fav.on { background: #FBE9DF; border-color: rgba(181,69,42,0.50); }

.shop-item-body { padding: 20rpx 20rpx 86rpx; position: relative; }
.shop-item-name {
  font-size: calc(26rpx * var(--fs-scale, 1)); font-weight: 700; color: #2A1F14;
  margin-bottom: 6rpx; letter-spacing: 1rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.shop-item-desc {
  font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; margin-bottom: 8rpx; line-height: 1.4;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 评分 / 销量 / 满减 */
.shop-item-meta {
  display: flex; align-items: center; gap: 6rpx;
  margin-bottom: 10rpx; flex-wrap: nowrap;
  font-size: calc(20rpx * var(--fs-scale, 1)); letter-spacing: 1rpx;
  white-space: nowrap;
}
.shop-rating { color: #C4935A; font-weight: 700; flex-shrink: 0; }
.shop-meta-divider { color: #C8B9A3; }
.shop-sold { color: #8B7A6B; flex-shrink: 0; }
.shop-promo-pill {
  margin-left: auto; flex-shrink: 0;
  padding: 2rpx 10rpx; border-radius: 4rpx;
  background: #FCE9E2; color: #B5452A;
  font-size: calc(18rpx * var(--fs-scale, 1)); letter-spacing: 1rpx;
  border: 1rpx solid rgba(181,69,42,0.20);
}

.shop-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-wrap: nowrap;
  min-height: 56rpx;
}
.shop-item-price {
  display: inline-flex; align-items: baseline;
  font-weight: 700; color: #B5452A; line-height: 1;
  min-width: 0;
  white-space: nowrap;
}
.shop-item-price.sale { color: #D4633C; }
.si-yuan { font-size: calc(22rpx * var(--fs-scale, 1)); font-weight: 600; margin-right: 2rpx; }
.si-int  { font-size: calc(40rpx * var(--fs-scale, 1)); font-weight: 800; letter-spacing: 0; }
.si-dec  { font-size: calc(22rpx * var(--fs-scale, 1)); font-weight: 600; }
.si-unit {
  font-size: calc(18rpx * var(--fs-scale, 1));
  font-weight: 400;
  color: #8B7A6B;
  margin-left: 4rpx;
  letter-spacing: 0;
  white-space: nowrap;
}
.si-origin {
  font-size: calc(20rpx * var(--fs-scale, 1));
  color: #8B7A6B;
  text-decoration: line-through;
}

/* 加购按钮（绝对定位到卡片右下角，统一对齐） */
.shop-add-cart {
  position: absolute; right: 20rpx; bottom: 20rpx;
  display: inline-flex; align-items: center; gap: 6rpx;
  padding: 10rpx 20rpx; border-radius: 999rpx;
  background: linear-gradient(135deg, #B5452A, #8C3420);
  color: #FFFFFF;
  font-size: calc(22rpx * var(--fs-scale, 1)); font-weight: 600; letter-spacing: 1rpx;
  box-shadow: 0 4rpx 12rpx rgba(181,69,42,0.32);
}
.shop-discount {
  margin-top: 6rpx;
  display: inline-block;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #FBE8E4;
  color: #B5452A;
  font-size: calc(18rpx * var(--fs-scale, 1));
  letter-spacing: 1rpx;
}

.hover-dim { opacity: 0.85; }
.page-bottom { height: 40rpx; }
