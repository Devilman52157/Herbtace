.page-jq { background: #F8F2E8; min-height: 100vh; padding-bottom: 40rpx; }

.jieqi-hero {
  position: relative; height: 440rpx;
  background: linear-gradient(170deg, #2A1F14, #3D2E1F);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.jieqi-hero::after {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(circle at 50% 40%, rgba(196,147,90,0.18), transparent 70%);
}
.jieqi-hero-inner { text-align: center; z-index: 1; color: #E8D5B5; }
.jieqi-hero-ic {
  width: 80rpx; height: 80rpx; margin: 0 auto 20rpx;
  display: flex; align-items: center; justify-content: center;
  opacity: 0.9;
}
.jieqi-hero-name {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(80rpx * var(--fs-scale, 1)); letter-spacing: 16rpx; color: #E8D5B5;
}
.jieqi-hero-date { font-size: calc(22rpx * var(--fs-scale, 1)); opacity: 0.6; margin-top: 12rpx; letter-spacing: 4rpx; }
.jieqi-hero-poem {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(30rpx * var(--fs-scale, 1)); margin-top: 24rpx; opacity: 0.8; letter-spacing: 6rpx;
}
.jieqi-hero-tag {
  position: absolute; top: 24rpx; right: 24rpx; z-index: 2;
  background: #B5452A; color: #E8D5B5;
  font-size: calc(20rpx * var(--fs-scale, 1)); padding: 6rpx 20rpx;
  border-radius: 4rpx; letter-spacing: 4rpx;
  box-shadow: 0 4rpx 14rpx rgba(181,69,42,0.4);
}

.jieqi-intro {
  margin: 28rpx 40rpx;
  padding: 28rpx 32rpx;
  background: #FFFCF5; border: 2rpx dashed #E8D5B5;
  border-radius: 12rpx;
  font-size: calc(24rpx * var(--fs-scale, 1)); color: #5C4A3A; line-height: 1.9; letter-spacing: 1rpx;
}

.jq-info-card {
  margin: 28rpx 40rpx 24rpx; padding: 28rpx;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
}
.jq-info-title {
  font-size: calc(26rpx * var(--fs-scale, 1)); font-weight: 700; color: #2A1F14;
  letter-spacing: 2rpx; margin-bottom: 12rpx;
  display: flex; align-items: center; gap: 10rpx;
}
.jieqi-tip-item {
  display: flex; align-items: flex-start; gap: 14rpx;
  padding: 16rpx 0; border-bottom: 2rpx solid rgba(196,147,90,0.1);
  font-size: calc(25rpx * var(--fs-scale, 1)); color: #2A1F14; line-height: 1.7;
}
.jieqi-tip-item:last-child { border-bottom: none; }
.jieqi-tip-dot {
  flex-shrink: 0; width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #B5452A; margin-top: 14rpx;
}

.jieqi-product-card {
  margin: 0 40rpx 16rpx;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
  padding: 20rpx; display: flex; gap: 20rpx;
}
.jp-thumb {
  width: 120rpx; height: 120rpx; flex-shrink: 0;
  background: #EDE4D4; border: 2rpx solid #E8D5B5;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.jp-img { width: 100%; height: 100%; display: block; }
.jp-body { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.jp-name { font-size: calc(28rpx * var(--fs-scale, 1)); font-weight: 700; color: #2A1F14; letter-spacing: 1rpx; }
.jp-origin {
  font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; margin-top: 4rpx;
  display: flex; align-items: center; gap: 6rpx;
}
.jp-bot {
  display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx;
}
.jp-price { font-size: calc(30rpx * var(--fs-scale, 1)); font-weight: 700; color: #B5452A; }
.jp-price small { font-size: calc(20rpx * var(--fs-scale, 1)); font-weight: 400; color: #8B7A6B; margin-left: 4rpx; }
.jp-tag {
  font-size: calc(20rpx * var(--fs-scale, 1)); padding: 4rpx 12rpx; border-radius: 4rpx;
  background: rgba(74,124,89,0.12); color: #4A7C59; letter-spacing: 1rpx;
}
.jq-more {
  margin: 24rpx 40rpx 0; padding: 24rpx;
  text-align: center;
  border: 2rpx solid #C4935A; border-radius: 8rpx;
  color: #5C4A3A; font-size: calc(26rpx * var(--fs-scale, 1)); letter-spacing: 4rpx;
  background: transparent;
}
.page-bottom { height: 40rpx; }
.hover-dim { opacity: 0.85; }
