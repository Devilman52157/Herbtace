/* ============ 登录页 — 首页 Hero 设计语言对齐 ============ */
.login-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: #F8F2E8;
  color: #2A1F14;
  overflow: hidden;
}

/* ===== Hero 区：暗调渐变 + 多层光效 ===== */
.login-hero {
  position: relative;
  height: 720rpx;
  padding: 110rpx 48rpx 0;
  background: linear-gradient(135deg,
    #1A0F08 0%,
    #3D1F12 25%,
    #5C3420 50%,
    #4A3828 75%,
    #2A4030 100%);
  overflow: hidden;
  isolation: isolate;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
}

.hero-glow {
  position: absolute; z-index: 0; pointer-events: none;
  width: 1100rpx; height: 1100rpx;
  top: -340rpx; right: -360rpx;
  background: conic-gradient(
    from 0deg,
    rgba(181,69,42,0.55),
    rgba(196,147,90,0.45),
    rgba(74,124,89,0.40),
    rgba(196,147,90,0.45),
    rgba(181,69,42,0.55)
  );
  filter: blur(60rpx); opacity: 1;
  animation: loginGlowRotate 18s linear infinite;
}

.hero-clouds {
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='720' height='200' viewBox='0 0 720 200'><g fill='%23E8D5B5'><path d='M40 130 C20 130 8 116 22 106 C14 90 36 78 52 86 C58 70 92 70 100 86 C112 74 138 78 142 96 C162 96 168 116 152 124 Z'/><path d='M310 100 C290 100 278 86 292 76 C284 60 306 48 322 56 C328 40 362 40 370 56 C382 44 408 48 412 66 C432 66 438 86 422 94 Z'/><path d='M540 150 C524 150 514 138 526 130 C520 116 540 108 552 116 C558 102 588 102 594 116 C604 106 626 110 630 124 C644 124 650 142 636 148 Z'/></g></svg>"),
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='560' height='160' viewBox='0 0 560 160'><g fill='%23FFE7A8'><path d='M70 100 C56 100 48 90 58 84 C52 72 70 64 80 70 C84 60 108 60 114 70 C124 62 142 66 144 80 C158 80 162 92 152 98 Z'/><path d='M340 60 C328 60 322 50 330 46 C324 36 344 30 352 36 C356 26 376 26 380 36 C388 30 402 34 404 44 C414 44 418 54 410 58 Z'/></g></svg>");
  background-repeat: repeat-x, repeat-x;
  background-size: 720rpx 200rpx, 560rpx 160rpx;
  background-position: 0% 32%, 0% 72%;
  opacity: 0.30;
  filter: blur(8rpx);
  mix-blend-mode: screen;
  animation: loginCloudDrift 90s linear infinite,
             loginCloudPulse 10s ease-in-out infinite alternate;
}

.hero-aurora {
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background: linear-gradient(115deg,
    transparent 20%,
    rgba(232,213,181,0.20) 40%,
    rgba(255,215,140,0.32) 50%,
    rgba(232,213,181,0.20) 60%,
    transparent 80%);
  background-size: 220% 220%;
  animation: loginAurora 6s linear infinite;
  mix-blend-mode: screen;
}

/* 右上角"登"水印 — 金色流光毛笔字 */
.hero-deco {
  position: absolute; z-index: 1;
  top: 96rpx; right: 32rpx;
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi","FangSong",serif;
  font-size: calc(220rpx * var(--fs-scale, 1));
  line-height: 1;
  background: linear-gradient(120deg,
    #C4935A 0%,
    #E8D5B5 20%,
    #FFE7A8 40%,
    #F5C97A 55%,
    #E8D5B5 75%,
    #C4935A 100%);
  background-size: 220% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(232,213,181,0.32);
  opacity: 0.34;
  animation: loginDecoShimmer 5s linear infinite,
             loginDecoBreathe 6s ease-in-out infinite alternate;
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: left;
}

.hero-tag {
  display: inline-block;
  background: rgba(181,69,42,0.22);
  color: #E8D5B5;
  font-size: calc(22rpx * var(--fs-scale, 1));
  padding: 8rpx 28rpx;
  border: 2rpx solid rgba(196,147,90,0.45);
  border-radius: 999rpx;
  margin-bottom: 28rpx;
  letter-spacing: 4rpx;
  animation: loginTagPulse 3s ease-in-out infinite alternate;
}

.hero-title {
  font-size: calc(96rpx * var(--fs-scale, 1));
  line-height: 1.15;
  letter-spacing: 14rpx;
  color: #FFFCF5;
  text-shadow: 0 4rpx 18rpx rgba(20,14,10,0.45);
  display: flex;
  gap: 6rpx;
}

.title-char {
  display: inline-block;
  animation: loginTitleFloat 5s ease-in-out infinite alternate;
}
.title-char:nth-child(1) { animation-delay: 0s; }
.title-char:nth-child(2) { animation-delay: 0.4s; }
.title-char:nth-child(3) { animation-delay: 0.8s; }
.title-char:nth-child(4) { animation-delay: 1.2s; }

.hero-sub {
  margin-top: 22rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  letter-spacing: 5rpx;
  color: rgba(232,213,181,0.86);
}

/* Hero 底部柔化过渡到米色页面 */
.hero-fade {
  position: absolute;
  z-index: 1;
  left: 0; right: 0; bottom: -2rpx;
  height: 90rpx;
  pointer-events: none;
  background: linear-gradient(180deg, transparent, rgba(248,242,232,0.72));
}

/* ===== 表单卡片 ===== */
.login-card {
  position: relative;
  z-index: 2;
  margin: -64rpx 36rpx 0;
  padding: 52rpx 40rpx 36rpx;
  background: #FFFCF5;
  border: 2rpx solid #E8D5B5;
  border-radius: 16rpx;
  box-shadow: 0 22rpx 56rpx rgba(42,31,20,0.16);
}

/* 卡片左上角红色印章 */
.seal-mark {
  position: absolute;
  top: -28rpx; left: 36rpx;
  width: 80rpx; height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #B5452A, #8C3420);
  color: #FFE7A8;
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi",serif;
  font-size: calc(40rpx * var(--fs-scale, 1));
  letter-spacing: 0;
  box-shadow: 0 8rpx 18rpx rgba(140,52,32,0.35);
  border: 2rpx solid rgba(232,213,181,0.5);
}

/* 卡片内分隔标题 */
.card-divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 30rpx;
  padding-top: 12rpx;
}
.cd-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #E8D5B5, transparent);
}
.cd-label {
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi","FangSong",serif;
  font-size: calc(32rpx * var(--fs-scale, 1));
  color: #5C4A3A;
  letter-spacing: 6rpx;
  white-space: nowrap;
}

/* 登录 / 注册 切换 */
.mode-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  height: 76rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
  background: #F5EDE0;
  border: 2rpx solid rgba(196,147,90,0.22);
  border-radius: 12rpx;
}
.mode-tab {
  min-width: 0;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 8rpx;
  color: #5C4A3A;
  font-size: calc(28rpx * var(--fs-scale, 1));
  font-weight: 700;
  letter-spacing: 4rpx;
  transition: all 0.2s ease;
}
.mode-tab.active {
  background: linear-gradient(180deg, #B5452A, #8C3420);
  color: #E8D5B5;
  box-shadow: 0 6rpx 16rpx rgba(181,69,42,0.28);
}

/* 输入框 */
.form-field {
  height: 92rpx;
  margin-bottom: 22rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #F5EDE0;
  border: 2rpx solid rgba(196,147,90,0.28);
  border-radius: 12rpx;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.form-field:focus-within {
  border-color: #B5452A;
  box-shadow: 0 0 0 4rpx rgba(181,69,42,0.10);
}
.field-icon {
  width: 42rpx; height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42rpx;
}
.field-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  color: #2A1F14;
  font-size: calc(27rpx * var(--fs-scale, 1));
}
.field-placeholder {
  color: rgba(92,74,58,0.52);
}

/* 主提交按钮 */
.login-submit {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin: 12rpx 0 0;
  padding: 0;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #B5452A, #8C3420);
  color: #E8D5B5;
  font-size: calc(30rpx * var(--fs-scale, 1));
  font-weight: 800;
  letter-spacing: 8rpx;
  box-shadow: 0 12rpx 24rpx rgba(181,69,42,0.30);
  position: relative;
  overflow: hidden;
}
.login-submit::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(115deg,
    transparent 30%,
    rgba(255,231,168,0.22) 50%,
    transparent 70%);
  background-size: 220% 220%;
  animation: loginAurora 5s linear infinite;
  pointer-events: none;
}
.login-submit-hover {
  opacity: 0.92;
  transform: translateY(2rpx);
}
.login-submit[disabled],
.wechat-submit[disabled] {
  opacity: 0.72;
}

/* 分隔"或" */
.divider-or {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 32rpx 0 22rpx;
  color: #8B7A6B;
  font-size: calc(22rpx * var(--fs-scale, 1));
  letter-spacing: 4rpx;
}
.dor-line {
  width: 100rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #E8D5B5);
}
.dor-line:last-child {
  background: linear-gradient(90deg, #E8D5B5, transparent);
}

/* 微信登录按钮 */
.wechat-submit {
  width: 100%;
  height: 86rpx;
  line-height: 86rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #FFFCF5;
  border: 2rpx solid #E8D5B5;
  color: #5C4A3A;
  font-size: calc(28rpx * var(--fs-scale, 1));
  letter-spacing: 4rpx;
  font-weight: 700;
}
.wechat-submit-inner {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.wechat-dot {
  width: 30rpx; height: 30rpx;
  border-radius: 50%;
  background: #4A7C59;
  position: relative;
  box-shadow: 0 2rpx 6rpx rgba(74,124,89,0.35);
}
.wechat-dot::after {
  content: '';
  position: absolute;
  right: -8rpx; bottom: 0;
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: #6B9E78;
}
.wechat-submit-hover {
  background: #F5EDE0;
}

/* 协议勾选 */
.login-agreement {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #8B7A6B;
  font-size: calc(21rpx * var(--fs-scale, 1));
  letter-spacing: 1rpx;
  line-height: 1.4;
}
.agreement-check {
  width: 30rpx; height: 30rpx;
  flex: 0 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  border: 2rpx solid #C4935A;
  background: #FFFCF5;
  transition: all 0.2s;
}
.agreement-check.checked {
  border-color: #B5452A;
  background: linear-gradient(135deg, #B5452A, #8C3420);
}

/* 页脚 */
.login-footer {
  margin-top: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #8B7A6B;
  font-size: calc(21rpx * var(--fs-scale, 1));
  letter-spacing: 4rpx;
}
.footer-line {
  width: 80rpx; height: 2rpx;
  background: linear-gradient(90deg, transparent, #C4935A);
  opacity: 0.58;
}
.footer-line:last-child {
  transform: rotate(180deg);
}

/* ===== 动画 ===== */
@keyframes loginGlowRotate {
  to { transform: rotate(360deg); }
}
@keyframes loginCloudDrift {
  0%   { background-position: 0% 32%, 0% 72%; }
  100% { background-position: 200% 32%, -200% 72%; }
}
@keyframes loginCloudPulse {
  0%   { opacity: 0.22; }
  100% { opacity: 0.36; }
}
@keyframes loginAurora {
  0%   { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}
@keyframes loginDecoShimmer {
  0%   { background-position: 0% 50%; }
  100% { background-position: 220% 50%; }
}
@keyframes loginDecoBreathe {
  0%   { opacity: 0.26; transform: scale(1); }
  100% { opacity: 0.40; transform: scale(1.04); }
}
@keyframes loginTagPulse {
  0%   { box-shadow: 0 0 0 0 rgba(196,147,90,0.30); }
  100% { box-shadow: 0 0 0 12rpx rgba(196,147,90,0); }
}
@keyframes loginTitleFloat {
  0%   { transform: translateY(0); }
  100% { transform: translateY(-6rpx); }
}
