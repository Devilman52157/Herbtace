.thist-page { background: #F8F2E8; min-height: 100vh; padding: 24rpx 0 40rpx; }

.thist-list { padding: 0 40rpx; display: flex; flex-direction: column; gap: 16rpx; }
.thist-card {
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
  padding: 24rpx; display: flex; align-items: center; gap: 20rpx;
}
.thist-ic {
  width: 72rpx; height: 72rpx; border-radius: 12rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #B5452A, #8C3420);
  display: flex; align-items: center; justify-content: center;
}
.thist-body { flex: 1; min-width: 0; }
.thist-n { font-size: calc(26rpx * var(--fs-scale, 1)); font-weight: 700; color: #2A1F14; letter-spacing: 1rpx; }
.thist-batch { font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; margin-top: 6rpx; letter-spacing: 1rpx; }
.thist-time { font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; flex-shrink: 0; }

.page-bottom { height: 40rpx; }
