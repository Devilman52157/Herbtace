/* ============ 专家对话 �?复用 chat 样式 ============ */
@import "../chat/chat.wxss";

.echat-page {
  height: 100vh; display: flex; flex-direction: column; background: #F8F2E8;
}

.echat-header {
  padding: 28rpx 40rpx;
  background: #FFFCF5; border-bottom: 2rpx solid #E8D5B5;
  display: flex; gap: 24rpx; align-items: center;
}
.echat-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, #2A1F14, #5C4A3A);
  color: #E8D5B5; font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(40rpx * var(--fs-scale, 1));
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.echat-info { flex: 1; min-width: 0; }
.echat-name {
  font-size: calc(30rpx * var(--fs-scale, 1)); font-weight: 700; color: #2A1F14;
  display: flex; align-items: center; gap: 12rpx;
}
.echat-badge {
  font-size: calc(18rpx * var(--fs-scale, 1)); font-weight: 400; color: #4A7C59;
  padding: 2rpx 12rpx; background: rgba(74,124,89,0.1);
  border-radius: 4rpx; letter-spacing: 1rpx;
}
.echat-title { font-size: calc(22rpx * var(--fs-scale, 1)); color: #8B7A6B; margin-top: 6rpx; }
