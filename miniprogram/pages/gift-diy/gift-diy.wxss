/* ============ 礼盒 DIY �?对齐 H5 ?============ */
.page-gift { background: #F8F2E8; min-height: 100vh; padding-bottom: 200rpx; }

.diy-hero {
  padding: 48rpx 40rpx 36rpx;
  color: #FFF; text-align: center;
  background: linear-gradient(135deg, #A0336B, #C4516B);
  position: relative; overflow: hidden;
}
.diy-hero::before {
  content: ''; position: absolute; top: -60rpx; right: -60rpx;
  width: 240rpx; height: 240rpx; border-radius: 50%;
  background: rgba(255,255,255,0.08);
}
.diy-tag {
  display: inline-block; padding: 6rpx 20rpx;
  background: rgba(255,255,255,0.2); border-radius: 4rpx;
  font-size: calc(20rpx * var(--fs-scale, 1)); letter-spacing: 3rpx; margin-bottom: 14rpx;
  position: relative; z-index: 1;
}
.diy-title {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(44rpx * var(--fs-scale, 1)); letter-spacing: 8rpx;
  position: relative; z-index: 1;
}
.gf-steps {
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx; margin-top: 24rpx; font-size: calc(22rpx * var(--fs-scale, 1)); opacity: 0.9;
  position: relative; z-index: 1;
}
.gf-steps .stp {
  padding: 6rpx 20rpx;
  border: 2rpx solid rgba(255,255,255,0.4); border-radius: 999rpx;
  letter-spacing: 1rpx;
}
.gf-steps .stp.on {
  background: #FFF; color: #A0336B;
  border-color: #FFF; font-weight: 700;
}
.gf-steps .dash { width: 24rpx; height: 2rpx; background: rgba(255,255,255,0.4); }

/* 步骤段标?*/
.diy-step-title {
  display: flex; align-items: center; gap: 12rpx;
  padding: 28rpx 40rpx 16rpx;
  font-size: calc(26rpx * var(--fs-scale, 1)); font-weight: 700; color: #2A1F14; letter-spacing: 2rpx;
}
.diy-step-n {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(34rpx * var(--fs-scale, 1)); color: #B5452A;
}
.diy-count { margin-left: auto; font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; font-weight: 400; }
.diy-count-num { color: #B5452A; font-size: calc(26rpx * var(--fs-scale, 1)); margin: 0 4rpx; font-weight: 700; }

/* 盒子选择 */
.box-list { padding: 0 40rpx 16rpx; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; }
.box-card {
  padding: 24rpx 16rpx; text-align: center;
  background: #FFFCF5; border: 3rpx solid #E8D5B5; border-radius: 12rpx;
}
.box-card.picked {
  border-color: #B5452A; background: rgba(181,69,42,0.04);
  box-shadow: 0 4rpx 14rpx rgba(181,69,42,0.15);
}
.bc-ic { display: flex; justify-content: center; margin-bottom: 10rpx; }
.bc-name {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(26rpx * var(--fs-scale, 1)); letter-spacing: 3rpx; color: #2A1F14; margin-bottom: 6rpx;
}
.bc-price { font-size: calc(22rpx * var(--fs-scale, 1)); color: #B5452A; font-weight: 700; }
.bc-cap { font-size: calc(18rpx * var(--fs-scale, 1)); color: #8B7A6B; margin-top: 4rpx; }

/* 药材选择 */
.pick-tip { text-align: center; padding: 12rpx 40rpx 20rpx; color: #8B7A6B; font-size: calc(22rpx * var(--fs-scale, 1)); }
.prod-grid {
  padding: 0 40rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx;
  max-height: 900rpx; overflow-y: auto;
}
.prod-card {
  position: relative;
  padding: 20rpx 16rpx;
  background: #FFFCF5; border: 3rpx solid #E8D5B5; border-radius: 8rpx;
}
.prod-card.picked {
  border-color: #B5452A; background: rgba(181,69,42,0.04);
}
.prod-card.picked::after {
  content: '✓'; position: absolute; top: 8rpx; right: 12rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #B5452A; color: #FFF;
  font-size: calc(22rpx * var(--fs-scale, 1)); font-weight: 900;
  display: flex; align-items: center; justify-content: center;
}
.pd-ic {
  width: 72rpx; height: 72rpx; margin: 0 auto 8rpx;
  border-radius: 10rpx; overflow: hidden;
  background: #EDE4D4;
  display: flex; align-items: center; justify-content: center;
}
.pd-img { width: 100%; height: 100%; display: block; }
.pd-name { font-size: calc(24rpx * var(--fs-scale, 1)); font-weight: 700; color: #2A1F14; }
.pd-price { font-size: calc(22rpx * var(--fs-scale, 1)); color: #B5452A; font-weight: 700; margin-top: 4rpx; }

/* 贺卡 */
.card-box {
  margin: 28rpx 40rpx; padding: 36rpx;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
  position: relative;
}
.card-deco {
  position: absolute; top: 20rpx; right: 32rpx;
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(72rpx * var(--fs-scale, 1)); color: rgba(196,147,90,0.25);
}
.card-in {
  width: 100%; min-height: 220rpx;
  font-size: calc(26rpx * var(--fs-scale, 1)); color: #2A1F14;
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
}

.sum {
  margin: 0 40rpx;
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 12rpx;
  padding: 24rpx 28rpx;
}
.sum-row { display: flex; justify-content: space-between; padding: 14rpx 0; font-size: calc(24rpx * var(--fs-scale, 1)); color: #5C4A3A; }
.sum-row .k { font-weight: 700; color: #2A1F14; }
.sum-row .price { color: #B5452A; font-weight: 700; font-size: calc(34rpx * var(--fs-scale, 1)); }

/* 底部 */
.foot-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 200;
  background: rgba(255,252,245,0.98);
  border-top: 2rpx solid #E8D5B5;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex; gap: 20rpx;
}
.fb-btn {
  flex: 1; padding: 24rpx; text-align: center;
  background: #B5452A; color: #FFF;
  border-radius: 8rpx; font-size: calc(26rpx * var(--fs-scale, 1)); font-weight: 700; letter-spacing: 4rpx;
}
.fb-btn.ghost {
  background: transparent; color: #B5452A; border: 2rpx solid #B5452A;
}
