/* ============ 药都研学 �?对齐 H5 ?============ */
.page-study { background: #F8F2E8; min-height: 100vh; padding-bottom: 40rpx; }
.btn-hover { opacity: 0.9; transform: scale(0.97); }

.st-hero {
  padding: 52rpx 40rpx 40rpx;
  color: #FFFCF5;
  background: linear-gradient(135deg, #4A7C59, #6B9E78);
  position: relative; overflow: hidden;
}
.st-hero::before {
  content: ''; position: absolute; right: -60rpx; bottom: -60rpx;
  width: 240rpx; height: 240rpx; border-radius: 50%;
  background: rgba(255,255,255,0.1);
}
.st-tag {
  display: inline-block; padding: 6rpx 20rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 4rpx; font-size: calc(20rpx * var(--fs-scale, 1)); letter-spacing: 3rpx;
  margin-bottom: 16rpx; position: relative; z-index: 1;
}
.st-title {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(48rpx * var(--fs-scale, 1)); letter-spacing: 8rpx; color: #FFF;
  position: relative; z-index: 1;
}
.st-sub {
  font-size: calc(22rpx * var(--fs-scale, 1)); margin-top: 10rpx; opacity: 0.9;
  letter-spacing: 1rpx; position: relative; z-index: 1;
}

.route-list { padding: 32rpx 40rpx; display: flex; flex-direction: column; gap: 28rpx; }
.route-card {
  background: #FFFCF5; border: 2rpx solid #E8D5B5; border-radius: 16rpx;
  overflow: hidden;
}
.rt-cover {
  position: relative; height: 160rpx; padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #EDE4D4, #E8D5B5);
  display: flex; align-items: flex-end;
}
.rt-cover::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(42,31,20,0.2));
}
.rt-cover-day {
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(28rpx * var(--fs-scale, 1)); letter-spacing: 4rpx; color: #2A1F14;
  position: relative; z-index: 1;
}
.rt-top { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 28rpx 0; }
.rt-tag {
  background: rgba(181,69,42,0.1); color: #B5452A;
  font-size: calc(20rpx * var(--fs-scale, 1)); padding: 4rpx 14rpx; border-radius: 4rpx; letter-spacing: 1rpx;
}
.rt-days { font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; margin-left: auto; }
.rt-name {
  font-size: calc(30rpx * var(--fs-scale, 1)); font-weight: 700; color: #2A1F14;
  margin: 12rpx 28rpx 10rpx; letter-spacing: 2rpx;
}
.rt-hi {
  font-size: calc(22rpx * var(--fs-scale, 1)); color: #8B7A6B;
  margin: 0 28rpx 16rpx; line-height: 1.7;
}
.rt-foot {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 28rpx 24rpx;
  border-top: 2rpx dashed rgba(196,147,90,0.3);
}
.rt-cap { font-size: calc(20rpx * var(--fs-scale, 1)); color: #8B7A6B; }
.rt-price { font-size: calc(36rpx * var(--fs-scale, 1)); color: #B5452A; font-weight: 700; margin-left: auto; }
.rt-price .u { font-size: calc(20rpx * var(--fs-scale, 1)); font-weight: 400; color: #8B7A6B; }
.rt-btn {
  background: #4A7C59; color: #FFF;
  padding: 14rpx 36rpx; border-radius: 8rpx;
  font-size: calc(24rpx * var(--fs-scale, 1)); font-weight: 700; letter-spacing: 3rpx;
}

/* 预约表单 */
.mask { position: fixed; inset: 0; background: rgba(42,31,20,0.7); z-index: 199; }
.sheet {
  position: fixed; left: 40rpx; right: 40rpx; top: 50%;
  transform: translateY(-50%);
  z-index: 200; max-height: 80vh; overflow-y: auto;
  background: #F8F2E8; border-radius: 16rpx; padding: 40rpx;
  animation: slideUp 0.3s ease;
}
.sh-head {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 20rpx; margin-bottom: 20rpx;
  border-bottom: 2rpx solid #E8D5B5;
  font-family: 'Ma Shan Zheng','STKaiti','KaiTi',serif;
  font-size: calc(34rpx * var(--fs-scale, 1)); letter-spacing: 3rpx; color: #2A1F14;
}
.fm-row { padding: 16rpx 0; }
.fm-k {
  display: block; font-size: calc(22rpx * var(--fs-scale, 1)); color: #8B7A6B;
  letter-spacing: 2rpx; margin-bottom: 10rpx;
}
.fm-in {
  width: 100%; padding: 16rpx 20rpx;
  min-height: calc(60rpx * var(--fs-scale, 1)); line-height: 1.5;
  box-sizing: border-box;
  background: #FFFCF5; color: #2A1F14;
  border: 2rpx solid #E8D5B5; border-radius: 8rpx;
  font-size: calc(26rpx * var(--fs-scale, 1));
}
.fm-in-ph { font-size: calc(26rpx * var(--fs-scale, 1)); color: #B5A595; }
.fm-btn {
  margin-top: 24rpx; background: #B5452A; color: #FFF;
  padding: 24rpx; border-radius: 8rpx;
  text-align: center; font-size: calc(26rpx * var(--fs-scale, 1)); font-weight: 700; letter-spacing: 6rpx;
}
.page-bottom { height: 40rpx; }
