/* ==========================================================
   全局样式 — 与 bencao-suoyuan-v2.html 对齐
   H5 以 px 为单位（375px 设计稿），小程序用 rpx（750 设计稿）
   换算规则：1px = 2rpx
   ========================================================== */

page {
  --ink:           #2A1F14;
  --ink-light:     #5C4A3A;
  --ink-lighter:   #8B7A6B;
  --vermilion:     #B5452A;
  --vermilion-dark:#8C3420;
  --vermilion-light:#D4694E;
  --gold:          #C4935A;
  --gold-light:    #E8D5B5;
  --gold-pale:     #F5EDE0;
  --jade:          #4A7C59;
  --jade-light:    #6B9E78;
  --paper:         #F8F2E8;
  --paper-dark:    #EDE4D4;
  --paper-deep:    #E0D5C3;
  --white:         #FFFCF5;

  background: #F8F2E8;
  color: #2A1F14;
  /* 正文优先用文楷；远程字体失败时，用楷体/仿宋兜底，减少系统黑体的方正感。 */
  font-family: "LXGW WenKai", "Kaiti SC", "STKaiti", "KaiTi", "FangSong", "STFangsong", "Noto Serif SC", "Songti SC", "STSong", "PingFang SC", serif;
  font-size: calc(26rpx * var(--fs-scale, 1));
  line-height: 1.5;
  --fs-scale: 1;
}
/* 字体缩放变量 — 所有 .wxss 中的 font-size 都通过 calc(... * var(--fs-scale)) 引用 */
.app-font-small  { --fs-scale: 0.9; }
.app-font-normal { --fs-scale: 1; }
.app-font-large  { --fs-scale: 1.18; }
.app-font-xlarge { --fs-scale: 1.35; }

view, text, button, input, textarea, scroll-view { box-sizing: border-box; font-family: inherit; }
button { font-family: inherit; }
button::after { border: none !important; }

/* 中式毛笔字（系统无此字体时回退 serif） */
.cn-brush { font-family: "Ma Shan Zheng", "Kaiti SC", "STKaiti", "KaiTi", "FangSong", "Songti SC", serif; }

/* ========= 分隔标题 ========= */
.divider {
  display: flex; align-items: center; gap: 24rpx;
  padding: 40rpx 40rpx 24rpx;
}
.divider::before, .divider::after {
  content: ''; flex: 1; height: 2rpx;
  background: linear-gradient(90deg, transparent, #E8D5B5, transparent);
}
.divider .label, .divider text {
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi","FangSong", serif;
  font-size: calc(36rpx * var(--fs-scale, 1)); color: #5C4A3A; letter-spacing: 8rpx;
  white-space: nowrap;
}

/* ========= 导航栏 ========= */
.nav-bar {
  position: sticky; top: 0; z-index: 100;
  display: flex; align-items: center; padding: 24rpx 32rpx;
  background: rgba(248,242,232,0.95);
  border-bottom: 2rpx solid #E8D5B5;
}
.nav-back {
  width: 64rpx; height: 64rpx; padding: 0; margin: 0;
  background: none; display: flex; align-items: center; justify-content: center;
}
.nav-title {
  flex: 1; text-align: center;
  font-family: "Ma Shan Zheng","Kaiti SC","STKaiti","KaiTi","FangSong",serif;
  font-size: calc(36rpx * var(--fs-scale, 1)); color: #2A1F14; letter-spacing: 6rpx;
}
.nav-ph { width: 64rpx; }

/* ========= 通用卡片 ========= */
.card {
  background: #FFFCF5; border: 2rpx solid #E8D5B5;
  border-radius: 16rpx; padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(42,31,20,0.04);
}

/* 带四角装饰的卡片（如专家卡、统计卡） */
.card-corner { position: relative; }
.card-corner::before, .card-corner::after {
  content: ''; position: absolute; width: 16rpx; height: 16rpx;
  border-color: #B5452A; border-style: solid;
}
.card-corner::before { top: -2rpx; left: -2rpx; border-width: 4rpx 0 0 4rpx; }
.card-corner::after  { bottom: -2rpx; right: -2rpx; border-width: 0 4rpx 4rpx 0; }

/* ========= 按钮 ========= */
.btn-primary {
  background: #B5452A; color: #E8D5B5;
  border-radius: 12rpx; padding: 24rpx;
  text-align: center; font-size: calc(30rpx * var(--fs-scale, 1)); letter-spacing: 4rpx; font-weight: 600;
}
.btn-ghost {
  background: transparent; color: #B5452A;
  border: 2rpx solid #B5452A; border-radius: 12rpx;
  padding: 20rpx; text-align: center; font-size: calc(26rpx * var(--fs-scale, 1));
}

/* ========= 价格 & 标签 ========= */
.price { color: #B5452A; font-weight: 700; }
.muted { color: #8B7A6B; }

.tag {
  display: inline-block; font-size: calc(20rpx * var(--fs-scale, 1)); padding: 4rpx 16rpx;
  border-radius: 4rpx; margin-right: 8rpx; letter-spacing: 1rpx;
  white-space: nowrap;
  color: #C4935A; background: rgba(196,147,90,0.08);
  border: 2rpx solid rgba(196,147,90,0.3);
}
.tag.r { color: #B5452A; background: rgba(181,69,42,0.06);  border-color: rgba(181,69,42,0.2); }
.tag.j { color: #4A7C59; background: rgba(74,124,89,0.06);  border-color: rgba(74,124,89,0.2); }
.tag.g { color: #C4935A; background: rgba(196,147,90,0.08); border-color: rgba(196,147,90,0.3); }

/* ========= 空状态 ========= */
.empty-state {
  text-align: center; padding: 144rpx 40rpx 80rpx; color: #8B7A6B;
}
.empty-state-ic {
  width: 96rpx; height: 96rpx; margin: 0 auto 28rpx;
  opacity: 0.55;
}
.empty-state-t { font-size: calc(26rpx * var(--fs-scale, 1)); letter-spacing: 2rpx; margin-bottom: 8rpx; color: #5C4A3A; }
.empty-state-s { font-size: calc(22rpx * var(--fs-scale, 1)); opacity: 0.7; }
.empty-cta {
  margin-top: 32rpx; display: inline-block;
  padding: 16rpx 48rpx; border: 2rpx solid #B5452A;
  color: #B5452A; border-radius: 8rpx;
  font-size: calc(24rpx * var(--fs-scale, 1)); letter-spacing: 2rpx;
}

/* ========= 底部占位 ========= */
.page-bottom { padding-bottom: 152rpx; }

/* ========= 动画 ========= */
@keyframes slideUp { from { opacity:0; transform: translateY(40rpx);} to { opacity:1; transform:none;} }
@keyframes fadeIn  { from { opacity:0; } to { opacity:1; } }

.hover-dim { opacity: 0.85; }

/* 字体大小通过 page 上的 --fs-scale 变量统一缩放，所有 font-size 由脚本批量改为 calc() */
